{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "request_id", "repository", "branch", "base_commit", "commit", "package_manifest_sha256", "workflow", "public_verifications", "changed_files"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "published_and_verified"},
    "request_id": {"type": "string"},
    "repository": {"const": "michaellhm/lhm-prototype"},
    "branch": {"const": "main"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "package_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "path", "run_id", "conclusion"],
      "properties": {
        "name": {"type": "string"}, "id": {"type": "integer"}, "path": {"type": "string"},
        "run_id": {"type": "integer"}, "conclusion": {"const": "success"}
      }
    },
    "public_verifications": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["url", "status", "bytes", "sha256"], "properties": {"url": {"type": "string"}, "status": {"const": 200}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "changed_files": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
