{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event", "event_id", "source_task_id", "source_task_url", "parent_run_id", "publication_request_id", "prototype_url", "prototype_commit", "package_manifest_sha256", "qa_reference", "workflow_state", "reviewer", "next_handoff", "created_at"],
  "properties": {
    "schema_version": {"const": 1}, "event": {"const": "prototype_publication_verified"},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "source_task_id": {"type": "string", "minLength": 1},
    "source_task_url": {"type": "string", "format": "uri"},
    "parent_run_id": {"type": "string", "minLength": 1},
    "publication_request_id": {"type": "string"}, "prototype_url": {"type": "string", "format": "uri"},
    "prototype_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "package_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qa_reference": {"type": "string", "minLength": 1},
    "workflow_state": {"const": "Under Review"}, "reviewer": {"const": "Michael"},
    "next_handoff": {"type": "string", "minLength": 1}, "created_at": {"type": "string"}
  }
}
