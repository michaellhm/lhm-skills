def contract(workflow_id, required_skills, required_capabilities=()):
    return {'workflow_id': workflow_id, 'required_skills': list(required_skills),
            'required_capabilities': list(required_capabilities)}


def registered_clients():
    try:
        payload = json.loads(CLIENT_REGISTRY.read_text(encoding='utf-8'))
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(f'client registry unavailable: {exc}')
    clients = payload.get('clients')
    if not isinstance(clients, dict):
        raise SystemExit('invalid client registry')
    return clients


def validate_run_id(run_id):
    if not re.fullmatch(r'claude-(?:gads|gsc|mktg|gdrive|basicops|register|delegate|producer)-[0-9]{8}-[0-9]{2}', run_id):
        raise SystemExit('invalid run_id')


def submit(client, objective):
    if client not in registered_clients():
        raise SystemExit('unregistered client')
    run_id = next_run_id('claude-gads')
    request = {'schema_version': 1, 'run_id': run_id, 'profile': 'google_ads_readonly', 'agent_id': 'lhm-marketing-hub:google-ads', 'client': client, 'objective': objective, 'timeout_seconds': 600, **contract('google-ads-monthly-review', ['lhm-marketing-hub:google-ads-monthly-review', 'lhm-marketing-hub:bid-budget-optimizer', 'lhm-marketing-hub:google-ads-conversion-audit', 'lhm-marketing-hub:google-ads-delivery-qa'], ['google_ads.account_read'])}
    incoming = BASE / 'incoming'
    fd, temp_name = tempfile.mkstemp(prefix=f'.{run_id}.', dir=incoming)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            json.dump(request, handle, indent=2)
            handle.write('\n')
        os.chmod(temp_name, 0o600)
        os.replace(temp_name, incoming / f'{run_id}.json')
    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)
    wait_for_completion(run_id)


def submit_marketing(client, objective):
    if client not in registered_clients():
        raise SystemExit('unregistered client')
    run_id = next_run_id('claude-mktg')
    request = {'schema_version': 1, 'run_id': run_id, 'profile': 'marketing_orchestrator_readonly', 'agent_id': 'lhm-marketing-hub:start', 'client': client, 'objective': objective, 'timeout_seconds': 600, **contract('marketing-review', ['lhm-marketing-hub:start'], ['google_ads.account_read'])}
    incoming = BASE / 'incoming'
    fd, temp_name = tempfile.mkstemp(prefix=f'.{run_id}.', dir=incoming)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            json.dump(request, handle, indent=2)
            handle.write('\n')
        os.chmod(temp_name, 0o600)
        os.replace(temp_name, incoming / f'{run_id}.json')
    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)
    wait_for_completion(run_id, max_wait_seconds=180)


def submit_gsc(site, urls, objective):
    run_id = next_run_id('claude-gsc')
    enqueue_and_wait({'schema_version': 1, 'run_id': run_id, 'profile': 'seo_gsc_readonly',
                      'agent_id': 'lhm-marketing-hub:seo', 'site': site,
                      'urls': urls, 'objective': objective, 'timeout_seconds': 600,
                      **contract('seo-gsc-review', ['lhm-marketing-hub:seo-audit'], ['google_search_console.property_read'])},
                     max_wait_seconds=540)


def next_run_id(prefix):
    date = datetime.now(ZoneInfo('Australia/Melbourne')).strftime('%Y%m%d')
    paths = []
    for bucket in ('incoming', 'processed', 'runs', 'failed'):
        paths += list((BASE / bucket).glob(f'{prefix}-{date}-*'))
    sequence = max([int(path.stem[-2:]) for path in paths if path.stem[-2:].isdigit()] or [0]) + 1
    if sequence > 99:
        raise SystemExit('daily run limit reached')
    return f'{prefix}-{date}-{sequence:02d}'


def enqueue_and_wait(request, max_wait_seconds=240):
    run_id = request['run_id']
    incoming = BASE / 'incoming'
    fd, temp_name = tempfile.mkstemp(prefix=f'.{run_id}.', dir=incoming)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            json.dump(request, handle, indent=2)
            handle.write('\n')
        os.chmod(temp_name, 0o600)
        os.replace(temp_name, incoming / f'{run_id}.json')
    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)
    wait_for_completion(run_id, max_wait_seconds=max_wait_seconds)


