def submit_specialist(route, subject_type, subject_name, objective):
    if route == 'project' and 'lhm-project-hub:hermes-production-plan' in objective:
        route = 'project-production-plan'
    agent_ids = {
        'marketing': 'lhm-marketing-hub:start',
        'seo': 'lhm-marketing-hub:seo',
        'seo-lead': 'lhm-marketing-hub:seo',
        'keyword-research': 'lhm-marketing-hub:seo',
        'seo-page-brief': 'lhm-marketing-hub:seo',
        'seo-delivery-qa': 'lhm-marketing-hub:seo',
        'content': 'lhm-marketing-hub:content',
        'project': 'lhm-project-hub:pm-orchestrator',
        'project-production-plan': 'lhm-project-hub:pm-orchestrator',
        'gmb': 'lhm-gmb-hub:gmb-orchestrator',
        'finance': 'lhm-finance-hub:finance-orchestrator',
        'website': 'lhm-wordpress-hub:website-orchestrator',
        'prototype': 'lhm-wordpress-hub:prototype-lead',
        'astro': 'lhm-wordpress-hub:astro-lead',
        'wordpress': 'lhm-wordpress-hub:wordpress-lead',
        'wordpress-rest': 'lhm-wordpress-hub:wordpress-lead',
        'knowledge': 'lhm-knowledge-hub:knowledge-orchestrator',
    }
    if route not in agent_ids:
        raise SystemExit('disallowed specialist route')
    if subject_type not in {'client', 'opportunity', 'internal', 'general'}:
        raise SystemExit('invalid subject_type')
    run_id = next_run_id('claude-delegate')
    enqueue_and_wait({'schema_version': 1, 'run_id': run_id, 'profile': 'specialist_readonly',
                      'agent_id': agent_ids[route], 'route': route, 'subject_type': subject_type,
                      'subject_name': subject_name, 'objective': objective,
                      'approval_state': 'review_only', 'timeout_seconds': 600,
                      **contract(f'{route}-review', [ROUTE_SKILLS[route]])})


def submit_producer_artifact(artifact_id, subject_name, output_name, objective):
    registry_path = Path('/opt/data/profiles/lhm_brain/config/claude-producer-artifacts.json')
    try:
        artifact = json.loads(registry_path.read_text(encoding='utf-8'))['artifacts'][artifact_id]
    except (OSError, json.JSONDecodeError, KeyError, TypeError):
        raise SystemExit('unknown producer artifact')
    supplied = {key: artifact[key] for key in ('logical_name', 'media_type', 'size_bytes', 'sha256', 'purpose')}
    supplied['artifact_id'] = artifact_id
    run_id = next_run_id('claude-producer')
    enqueue_and_wait({'schema_version': 2, 'run_id': run_id, 'profile': 'html_artifact_producer',
                      'agent_id': 'lhm-marketing-hub:content', 'route': 'content',
                      'subject_name': subject_name, 'objective': objective, 'output_name': output_name,
                      'input_artifacts': [supplied], 'timeout_seconds': 1200,
                      **contract('html-artifact-production', ['lhm-marketing-hub:content'])})


def wait_for_completion(run_id, max_wait_seconds=105):
    run_dir = BASE / 'runs' / run_id
    deadline = time.monotonic() + max_wait_seconds
    while time.monotonic() < deadline:
        final = run_dir / 'final.json'
        if final.is_file():
            payload = json.loads(final.read_text(encoding='utf-8'))
            print(json.dumps(payload))
            result_path = run_dir / 'result.md'
            if payload.get('status') == 'needs_review' and result_path.is_file():
                print('---RESULT---')
                print(result_path.read_text(encoding='utf-8'), end='')
            return
        time.sleep(1)
    print(json.dumps({'run_id': run_id, 'status': 'running', 'profile': 'google_ads_readonly', 'follow_up_required': True}))


def status(run_id):
    validate_run_id(run_id)
    run_dir = BASE / 'runs' / run_id
    final = run_dir / 'final.json'
    if final.exists():
        print(final.read_text(encoding='utf-8'), end='')
        return
    events = run_dir / 'events.jsonl'
    if events.exists():
        lines = events.read_text(encoding='utf-8').splitlines()
        print(lines[-1] if lines else json.dumps({'run_id': run_id, 'status': 'queued'}))
        return
    print(json.dumps({'run_id': run_id, 'status': 'pending_or_unknown'}))


def result(run_id):
    validate_run_id(run_id)
    path = BASE / 'runs' / run_id / 'result.md'
    if not path.is_file():
        raise SystemExit('result not ready')
    print(path.read_text(encoding='utf-8'), end='')


def main():
    if len(sys.argv) == 4 and sys.argv[1] == 'submit-google-ads-readonly':
        submit(sys.argv[2], sys.argv[3])
    elif len(sys.argv) == 4 and sys.argv[1] == 'submit-marketing-readonly':
        submit_marketing(sys.argv[2], sys.argv[3])
    elif len(sys.argv) == 5 and sys.argv[1] == 'submit-seo-gsc-readonly':
        submit_gsc(sys.argv[2], [url for url in sys.argv[3].split(',') if url], sys.argv[4])
    elif len(sys.argv) == 5 and sys.argv[1] == 'submit-google-drive-client-file-create':
        submit_drive_file(sys.argv[2], sys.argv[3], sys.argv[4])
    elif len(sys.argv) == 5 and sys.argv[1] == 'submit-basicops-task-discussion-update':
        submit_basicops_discussion(sys.argv[2], sys.argv[3], sys.argv[4])
    elif len(sys.argv) == 8 and sys.argv[1] == 'submit-basicops-task-baton-transition':
        submit_basicops_baton(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6], sys.argv[7])
    elif len(sys.argv) == 4 and sys.argv[1] == 'observe-basicops-human-decision':
        observe_basicops_human(sys.argv[2], sys.argv[3])
    elif len(sys.argv) == 8 and sys.argv[1] == 'register-handback-target':
        register_handback_target(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6], sys.argv[7])
    elif len(sys.argv) == 6 and sys.argv[1] == 'submit-specialist-readonly':
        submit_specialist(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5])
    elif len(sys.argv) == 6 and sys.argv[1] == 'submit-producer-artifact':
        submit_producer_artifact(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5])
    elif len(sys.argv) == 3 and sys.argv[1] == 'status':
        status(sys.argv[2])
    elif len(sys.argv) == 3 and sys.argv[1] == 'result':
        result(sys.argv[2])
    else:
        raise SystemExit('usage: claude-dispatch submit-specialist-readonly ROUTE SUBJECT_TYPE SUBJECT_NAME OBJECTIVE | submit-google-ads-readonly CLIENT OBJECTIVE | submit-seo-gsc-readonly SITE URLS_COMMA_SEPARATED OBJECTIVE | submit-marketing-readonly CLIENT OBJECTIVE | submit-google-drive-client-file-create CLIENT ARTIFACT_PATH FILE_NAME | submit-basicops-task-discussion-update CLIENT TASK_ID DISCUSSION | register-handback-target TYPE SLUG NAME VAULT_PREFIX DRIVE_FOLDER_ID TASK_IDS_COMMA_SEPARATED_OR_DASH | status RUN_ID | result RUN_ID')


if __name__ == '__main__':
    main()
