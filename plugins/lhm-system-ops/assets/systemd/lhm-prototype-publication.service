[Unit]
Description=Stage and publish governed prototype packages

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/lhm-prototype-publication-runtime
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermes/.hermes/profiles/lhm_brain/dispatch/prototype-publication /var/lib/lhm-prototype-publication
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
