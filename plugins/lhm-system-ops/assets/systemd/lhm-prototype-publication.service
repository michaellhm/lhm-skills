[Unit]
Description=Validate and dispatch governed prototype publication
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/lhm-prototype-publication-runtime
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermes/.hermes/profiles/lhm_brain/dispatch/prototype-publication /var/lib/lhm-prototype-publication /srv/lhm-prototype-publisher
ReadOnlyPaths=/etc/lhm-prototype-publisher
InaccessiblePaths=/home/hermes/.hermes/profiles/lhm_brain/dispatch/prototype-publication/sealed
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
