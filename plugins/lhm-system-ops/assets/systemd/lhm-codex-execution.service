[Unit]
Description=Run subscription-authenticated Codex worker for lhm_brain
[Service]
Type=oneshot
ExecStartPre=+/usr/bin/setfacl -n -m m::--x,u:codexworker:--x /home/hermes/.hermes
ExecStartPre=+/usr/bin/setfacl -n -m m::--x,u:codexworker:--x /home/hermes/.hermes/profiles/lhm_brain
ExecStartPre=+/usr/bin/setfacl -n -m m::--x,u:codexworker:--x /home/hermes/.hermes/profiles/lhm_brain/dispatch/codex-execution
ExecStart=/usr/local/libexec/lhm-codex-execution-worker
User=codexworker
Group=codexworker
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/home/hermes/.hermes/profiles/lhm_brain/dispatch/codex-execution
InaccessiblePaths=/home/hermes/.hermes/profiles/lhm_brain/vault /var/run/docker.sock /run/docker.sock /root
