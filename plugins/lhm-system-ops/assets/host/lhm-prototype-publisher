#!/usr/bin/env python3
"""Root-owned, repository-scoped LHM static prototype publisher."""
import argparse, fcntl, hashlib, json, os, re, shutil, stat, subprocess, time, urllib.request
from pathlib import Path, PurePosixPath

REPOSITORY = 'michaellhm/lhm-prototype'
BRANCH = 'main'
REMOTE = 'ssh://git@ssh.github.com:443/michaellhm/lhm-prototype.git'
PUBLIC_ROOT = 'https://lhmstaging.net/prototypes'
SSH_KEY = Path('/etc/lhm-prototype-publisher/id_ed25519')
KNOWN_HOSTS = Path('/etc/lhm-prototype-publisher/known_hosts')
CHECKOUT = Path('/srv/lhm-prototype-publisher/lhm-prototype')
SOURCE_ROOT = Path('/var/lib/lhm-prototype-publication/incoming')
STATE_ROOT = Path('/var/lib/lhm-prototype-publication/receipts')
WORKFLOW = {'name':'Deploy to lhmstaging','id':289562388,'path':'.github/workflows/deploy.yml'}
DEPLOYMENT_HELPER = Path('/usr/local/libexec/lhm-task-router/github_deployment.py')
DEPLOYMENT_PYTHON = Path('/opt/lhm-workspace-mcp/bin/python')
RUNUSER = '/usr/sbin/runuser'
PROFILE_ID = 'prototype-main-v1'
CREDENTIAL_REFERENCE = 'LHM_PROTOTYPE_MAIN_DEPLOY_KEY'
STANDING_AUTHORITY = 'MICHAEL-PROTOTYPE-PUBLISH-STANDING-20260820'
SAFE_ID = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$')
SLUG = re.compile(r'^[a-z0-9]+(?:-[a-z0-9]+)*$')
SHA = re.compile(r'^[0-9a-f]{40}$')
SHA256 = re.compile(r'^[0-9a-f]{64}$')
STATIC_EXTENSIONS = {'.html', '.css', '.js', '.json', '.png', '.jpg', '.jpeg', '.gif', '.webp', '.svg', '.ico', '.avif', '.woff', '.woff2', '.ttf', '.otf'}
TEXT_EXTENSIONS = {'.html', '.css', '.js', '.json', '.svg', '.md'}
SENSITIVE = re.compile(rb'(BEGIN [A-Z ]*PRIVATE KEY|github_pat_|ghp_|(?<![A-Za-z0-9])sk-[A-Za-z0-9]|AKIA[0-9A-Z]{16}|password\s*[:=]|client_secret\s*[:=])', re.I)
MAX_FILE = 10_000_000
MAX_HTTP = 2_000_000
FIELDS = {'schema_version','request_id','source_basicops_task','governed_parent','destination_profile_id','operation','credential_reference','client_slug','project_slug','prototype_kind','repository','branch','expected_base_commit','source_directory','source_package_sha256','source_drive_file_id','source_drive_file_sha256','source_drive_file_bytes','file_manifest','qa_evidence_reference','idempotency_key','standing_authority_reference','commit_message'}

def run(args, *, env=None, raw=False):
    output = subprocess.run(args, check=True, capture_output=True, text=True, env=env).stdout
    return output if raw else output.strip()

def git(*args, env=None):
    # Porcelain status begins with two meaningful status columns (e.g. ' M').
    # Preserve the complete NUL-delimited machine output before slicing paths.
    raw = '--porcelain=v1' in args and '-z' in args
    return run(['git','-c',f'safe.directory={CHECKOUT}','-C',str(CHECKOUT),*args], env=env, raw=raw)

def digest_file(path):
    h=hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024*1024), b''): h.update(block)
    return h.hexdigest()

def package_digest(manifest):
    canonical=(json.dumps(manifest,sort_keys=True,separators=(',',':'))+'\n').encode()
    return hashlib.sha256(canonical).hexdigest()

def prototype_prefix(r):
    return f"{r['client_slug']}/{r['project_slug']}/"

def generated_index_paths(r):
    return {'README.md', f"{r['client_slug']}/README.md"}

def generated_index_content(r):
    url=f"{PUBLIC_ROOT}/{r['client_slug']}/{r['project_slug']}/"
    return f"- [{r['client_slug']} / {r['project_slug']}]({url})\n".encode()

def validate_contract(r):
    if not isinstance(r,dict) or set(r)!=FIELDS or r.get('schema_version')!=3:
        raise ValueError('invalid prototype publication request schema')
    for field in ('request_id','source_basicops_task','governed_parent','qa_evidence_reference','idempotency_key','standing_authority_reference'):
        if not isinstance(r[field],str) or not SAFE_ID.fullmatch(r[field]): raise ValueError(f'invalid {field}')
    if r['request_id'] != r['idempotency_key']: raise ValueError('request_id must equal idempotency_key')
    if r['destination_profile_id']!=PROFILE_ID: raise ValueError('destination profile is not enabled')
    if r['credential_reference']!=CREDENTIAL_REFERENCE: raise ValueError('credential reference is not allowlisted')
    if not SLUG.fullmatch(r['client_slug']) or not SLUG.fullmatch(r['project_slug']): raise ValueError('invalid canonical client/project slug')
    if r['prototype_kind'] not in {'sitemap','homepage'}: raise ValueError('prototype_kind is not allowlisted')
    if r['operation'] != 'publish_'+r['prototype_kind']: raise ValueError('operation is not allowlisted for prototype kind')
    if r['project_slug'] != r['prototype_kind']: raise ValueError('project_slug must identify the governed prototype kind')
    if r['repository']!=REPOSITORY or r['branch']!=BRANCH: raise ValueError('repository and branch are not allowlisted')
    if r['standing_authority_reference']!=STANDING_AUTHORITY: raise ValueError('standing authority is not allowlisted')
    if not isinstance(r['expected_base_commit'],str) or not SHA.fullmatch(r['expected_base_commit']): raise ValueError('invalid expected_base_commit')
    if not isinstance(r['source_package_sha256'],str) or not SHA256.fullmatch(r['source_package_sha256']): raise ValueError('invalid source_package_sha256')
    if not isinstance(r['source_drive_file_id'],str) or not SAFE_ID.fullmatch(r['source_drive_file_id']): raise ValueError('invalid source_drive_file_id')
    if not isinstance(r['source_drive_file_sha256'],str) or not SHA256.fullmatch(r['source_drive_file_sha256']): raise ValueError('invalid source_drive_file_sha256')
    if not isinstance(r['source_drive_file_bytes'],int) or not 0 < r['source_drive_file_bytes'] <= MAX_FILE: raise ValueError('invalid source_drive_file_bytes')
    if not isinstance(r['commit_message'],str) or not re.fullmatch(r'prototype: [a-z0-9-]+/(sitemap|homepage) [A-Za-z0-9][A-Za-z0-9 ._-]{0,80}',r['commit_message']): raise ValueError('invalid bounded commit message')
    return r

def validate(r):
    validate_contract(r)
    source=Path(r['source_directory']); expected=(SOURCE_ROOT/r['request_id']).resolve()
    if source.resolve()!=expected or source.parent.resolve()!=SOURCE_ROOT.resolve() or not source.is_dir() or source.is_symlink(): raise ValueError('invalid source_directory')
    manifest=r['file_manifest']
    if not isinstance(manifest,list) or not manifest: raise ValueError('file_manifest must be non-empty')
    paths=[item.get('path') for item in manifest if isinstance(item,dict)]
    if len(paths)!=len(manifest) or paths!=sorted(set(paths)): raise ValueError('file_manifest must be exact, sorted and unique')
    prefix=prototype_prefix(r); has_index=False; index_links=0
    for item in manifest:
        if set(item)!= {'path','sha256','bytes'} or not SHA256.fullmatch(str(item['sha256'])) or not isinstance(item['bytes'],int) or not 0 <= item['bytes'] <= MAX_FILE: raise ValueError('invalid file manifest entry')
        value=item['path']; path=PurePosixPath(value)
        if not isinstance(value,str) or path.is_absolute() or '..' in path.parts or any(part.startswith('.') for part in path.parts): raise ValueError(f'unsafe or dotfile path: {value}')
        if value.startswith('.github/') or value in {'.gitmodules','.gitattributes','.gitignore'}: raise ValueError(f'repository configuration is forbidden: {value}')
        candidate=source.joinpath(*path.parts)
        if not candidate.is_file() or candidate.is_symlink() or candidate.stat().st_size!=item['bytes'] or digest_file(candidate)!=item['sha256']: raise ValueError(f'source file does not match manifest: {value}')
        if SENSITIVE.search(candidate.read_bytes()): raise ValueError(f'sensitive content detected: {value}')
        if value in generated_index_paths(r):
            index_links += 1
            if candidate.read_bytes()!=generated_index_content(r): raise ValueError(f'README link is not narrowly generated: {value}')
        else:
            if not value.startswith(prefix) or path.suffix.lower() not in STATIC_EXTENSIONS: raise ValueError(f'non-static or out-of-project path: {value}')
            has_index |= value == prefix+'index.html'
    if index_links>2: raise ValueError('too many generated README links')
    if not has_index: raise ValueError('prototype requires index.html')
    if package_digest(manifest)!=r['source_package_sha256']: raise ValueError('source package digest does not match manifest')
    index=next(item for item in manifest if item['path']==prefix+'index.html')
    if index['sha256']!=r['source_drive_file_sha256'] or index['bytes']!=r['source_drive_file_bytes']:
        raise ValueError('Drive readback does not match approved index.html')
    return [item['path'] for item in manifest]

def ssh_env():
    if not SSH_KEY.is_file() or not KNOWN_HOSTS.is_file(): raise ValueError('prototype publisher credential is not configured')
    env=os.environ.copy(); env['GIT_SSH_COMMAND']=f'/usr/bin/ssh -i {SSH_KEY} -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile={KNOWN_HOSTS}'
    return env

def receipt_path(key): return STATE_ROOT/f'{key}.json'
def pending_path(key): return STATE_ROOT/f'{key}.pending.json'
def request_digest(r): return hashlib.sha256(json.dumps(r,sort_keys=True,separators=(',',':')).encode()).hexdigest()

def prior_receipt(r):
    path=receipt_path(r['idempotency_key'])
    if not path.exists(): return None
    value=json.loads(path.read_text(encoding='utf-8'))
    if value.get('request_digest') != request_digest(r): raise ValueError('idempotency key was already used for a different request')
    return value['result']

def store_receipt(r,result,legacy_backup=None):
    STATE_ROOT.mkdir(parents=True,exist_ok=True,mode=0o700)
    payload={'request_digest':request_digest(r),'result':result}
    if legacy_backup is not None: payload['legacy_workflow_receipt_backup']=str(legacy_backup)
    temporary=receipt_path(r['idempotency_key']).with_suffix(f'.{os.getpid()}.tmp')
    flags=os.O_WRONLY|os.O_CREAT|os.O_EXCL
    fd=os.open(temporary,flags,0o600)
    with os.fdopen(fd,'w') as stream: json.dump(payload,stream,sort_keys=True); stream.write('\n')
    os.replace(temporary,receipt_path(r['idempotency_key']))

def preflight_deployment_reader():
    try:
        info = DEPLOYMENT_HELPER.lstat()
    except FileNotFoundError:
        raise ValueError('exact deployment reader is not installed')
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022 or info.st_nlink != 1:
        raise ValueError('exact deployment reader must be protected root-owned source')
    if not DEPLOYMENT_PYTHON.is_file() or not os.access(DEPLOYMENT_PYTHON, os.X_OK) or not os.path.isfile(RUNUSER):
        raise ValueError('existing authenticated deployment runtime is unavailable')


def validate_deployment_action(action, commit):
    if (not isinstance(action, dict) or type(action.get('id')) is not int or action['id'] <= 0
            or action.get('workflow_id') != WORKFLOW['id'] or action.get('name') != WORKFLOW['name']
            or action.get('path') != WORKFLOW['path'] or action.get('head_sha') != commit
            or action.get('head_branch') != BRANCH or action.get('status') != 'completed'
            or action.get('conclusion') != 'success'
            or action.get('html_url') != f'https://github.com/{REPOSITORY}/actions/runs/{action["id"]}'):
        raise ValueError('exact successful deployment workflow has not been verified')
    return action


def verify_deployment(commit):
    if not isinstance(commit, str) or not SHA.fullmatch(commit):
        raise ValueError('exact deployment commit required')
    preflight_deployment_reader()
    result = subprocess.run([RUNUSER, '-u', 'codexworker', '--', str(DEPLOYMENT_PYTHON),
                             str(DEPLOYMENT_HELPER), '--commit', commit],
                            capture_output=True, text=True, timeout=400, check=False)
    if result.returncode:
        raise ValueError('existing GitHub MCP did not verify the exact deployment workflow')
    if len(result.stdout) > 32768:
        raise ValueError('deployment reader returned oversized evidence')
    return validate_deployment_action(json.loads(result.stdout), commit)


def refresh_legacy_workflow_receipt(r, previous):
    commit = previous.get('commit')
    action = verify_deployment(commit)
    path = receipt_path(r['idempotency_key'])
    original = path.read_bytes()
    backup = path.with_name(path.stem + '.legacy-workflow-v1.json')
    if backup.exists():
        if backup.is_symlink() or backup.read_bytes() != original:
            raise ValueError('legacy deployment receipt backup conflicts')
    else:
        fd = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, 'wb') as stream:
            stream.write(original)
    updated = dict(previous)
    updated['workflow'] = workflow_evidence(action)
    store_receipt(r, updated, legacy_backup=backup)
    return updated


def workflow_evidence(action):
    return {**WORKFLOW, 'run_id': action['id'], 'head_sha': action['head_sha'],
            'head_branch': action['head_branch'], 'status': action['status'],
            'conclusion': action['conclusion'], 'html_url': action.get('html_url')}


def preflight_deployment_access():
    preflight_deployment_reader()
    result = subprocess.run([RUNUSER, '-u', 'codexworker', '--', str(DEPLOYMENT_PYTHON),
                             str(DEPLOYMENT_HELPER), '--preflight'],
                            capture_output=True, text=True, timeout=90, check=False)
    if result.returncode or len(result.stdout) > 32768:
        raise ValueError('existing GitHub deployment read route is unavailable before publication')
    expected = {'status':'ready','repository':REPOSITORY,'workflow_id':WORKFLOW['id']}
    if json.loads(result.stdout) != expected:
        raise ValueError('GitHub deployment preflight does not match the registered route')


def preflight_post_publish_dependencies():
    if not shutil.which('git') or not shutil.which('ssh'): raise ValueError('required repository transport dependency is unavailable')
    preflight_deployment_access()
    STATE_ROOT.mkdir(parents=True,exist_ok=True,mode=0o700)
    probe=STATE_ROOT/f'.preflight-{os.getpid()}'
    fd=os.open(probe,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600); os.close(fd); probe.unlink()

def verify_public_url(r,commit):
    url=f"{PUBLIC_ROOT}/{r['client_slug']}/{r['project_slug']}/"
    req=urllib.request.Request(url,method='GET',headers={'User-Agent':'LHM-Prototype-Publisher/2'})
    with urllib.request.urlopen(req,timeout=20) as response:
        body=response.read(MAX_HTTP+1)
        if response.status!=200 or not body or len(body)>MAX_HTTP: raise ValueError('bounded prototype HTTP verification failed')
    index=next(item for item in r['file_manifest'] if item['path']==prototype_prefix(r)+'index.html')
    digest=hashlib.sha256(body).hexdigest()
    if len(body)!=index['bytes'] or digest!=index['sha256']: raise ValueError('public prototype content does not match approved index.html')
    return {'url':url,'status':200,'bytes':len(body),'sha256':digest,'commit':commit}

def wait_for_public_deploy(r,commit):
    for _ in range(30):
        try:
            return verify_public_url(r,commit)
        except Exception:
            time.sleep(10)
    raise ValueError('exact public prototype content was not observed after deployment')

def approved_changes(paths,observed,index,anchor_unchanged):
    """Only the unchanged homepage index may accompany a changed-file package."""
    expected=[value for value in paths if value!=index] if anchor_unchanged else paths
    if not observed or observed!=expected:
        raise ValueError('checkout changes do not match the approved manifest')
    return observed

def _publish_locked(r):
    paths=validate(r); previous=prior_receipt(r)
    if previous:
        workflow = previous.get('workflow', {})
        if (type(workflow.get('run_id')) is not int or workflow['run_id'] <= 0
                or workflow.get('id') != WORKFLOW['id'] or workflow.get('name') != WORKFLOW['name']
                or workflow.get('path') != WORKFLOW['path'] or workflow.get('head_branch') != BRANCH
                or workflow.get('head_sha') != previous.get('commit')
                or workflow.get('status') != 'completed' or workflow.get('conclusion') != 'success'
                or workflow.get('html_url') != f'https://github.com/{REPOSITORY}/actions/runs/{workflow.get("run_id")}'):
            return refresh_legacy_workflow_receipt(r, previous)
        return previous
    env=ssh_env(); preflight_post_publish_dependencies(); git('fetch','--no-tags',REMOTE,BRANCH,env=env)
    fetched=git('rev-parse','FETCH_HEAD')
    pending=pending_path(r['idempotency_key'])
    if pending.exists():
        journal=json.loads(pending.read_text(encoding='utf-8'))
        if journal.get('request_digest')!=request_digest(r) or not SHA.fullmatch(journal.get('commit','')): raise ValueError('invalid pending release receipt')
        commit=journal['commit']
        if fetched!=commit: raise ValueError('remote no longer equals the interrupted exact release commit')
        public=wait_for_public_deploy(r,commit); action=verify_deployment(commit)
        actual=journal.get('changed_files',paths)
        if not isinstance(actual,list) or actual!=sorted(set(actual)): raise ValueError('invalid pending changed files')
        approved_changes(paths,actual,prototype_prefix(r)+'index.html',prototype_prefix(r)+'index.html' not in actual)
        result=release_result(r,actual,commit,action,public)
        store_receipt(r,result); pending.unlink(); return result
    if fetched!=r['expected_base_commit']: raise ValueError('main moved since evidence-bound approval; redispatch with a fresh base')
    git('reset','--hard',r['expected_base_commit']); git('clean','-ffd')
    source=Path(r['source_directory'])
    anchor=prototype_prefix(r)+'index.html'
    base_index=CHECKOUT/anchor
    anchor_unchanged=base_index.is_file() and digest_file(base_index)==digest_file(source/anchor)
    for value in paths:
        destination=CHECKOUT.joinpath(*PurePosixPath(value).parts); destination.parent.mkdir(parents=True,exist_ok=True); shutil.copyfile(source/value,destination)
    changed=git('status','--porcelain=v1','-z','--untracked-files=all').split('\0')
    observed=sorted(line[3:] for line in changed if line)
    approved_changes(paths,observed,anchor,anchor_unchanged)
    git('add','--',*observed); git('-c','user.name=LHM Prototype Publisher','-c','user.email=prototype-publisher@localhealthmarketing.com.au','commit','-m',r['commit_message'])
    commit=git('rev-parse','HEAD')
    atomic_pending={'request_digest':request_digest(r),'commit':commit,'base_commit':r['expected_base_commit'],'changed_files':observed}
    temporary=pending.with_suffix(f'.{os.getpid()}.tmp')
    fd=os.open(temporary,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
    with os.fdopen(fd,'w') as stream: json.dump(atomic_pending,stream,sort_keys=True); stream.write('\n')
    os.replace(temporary,pending)
    # A lease makes the final write fail closed if main moves after the fetch check.
    git('push',f'--force-with-lease=refs/heads/{BRANCH}:{r["expected_base_commit"]}',REMOTE,f'{commit}:refs/heads/{BRANCH}',env=env)
    remote=run(['git','ls-remote',REMOTE,f'refs/heads/{BRANCH}'],env=env).split()
    if len(remote)!=2 or remote[0]!=commit: raise ValueError('exact remote main SHA verification failed')
    public=wait_for_public_deploy(r,commit); action=verify_deployment(commit)
    result=release_result(r,observed,commit,action,public)
    store_receipt(r,result); pending.unlink(); return result

def release_result(r,paths,commit,action,public):
    evidence={'client_slug':r['client_slug'],'project_slug':r['project_slug'],'release_receipt_id':r['idempotency_key'],'repository':REPOSITORY,'commit':commit,'public_url':public['url'],'verification_sha256':public['sha256'],'mutation_performed':False}
    qa={'recipient':'independent_qa','receipt_id':r['idempotency_key'],'status':'awaiting_independent_receipt_review'}
    handoff={'contract_version':1,'skill':'lhm-project-hub:basicops-task-manager','source_task':r['source_basicops_task'],'state':'Under Review','complete':False,'human_task_open':True,'native_review_required':True,'reviewer':'Michael','client_contact':False,'mutation_performed':False}
    return {'schema_version':3,'status':'published_and_verified','request_id':r['request_id'],'destination_profile_id':PROFILE_ID,'operation':r['operation'],'repository':REPOSITORY,'branch':BRANCH,'base_commit':r['expected_base_commit'],'commit':commit,'source_package_sha256':r['source_package_sha256'],'workflow':workflow_evidence(validate_deployment_action(action,commit)),'public_verifications':[public],'changed_files':paths,'source_basicops_task':r['source_basicops_task'],'governed_parent':r['governed_parent'],'qa_evidence_reference':r['qa_evidence_reference'],'idempotency_key':r['idempotency_key'],'standing_authority_reference':r['standing_authority_reference'],'independent_qa_handoff':qa,'canonical_client_state_evidence':evidence,'review_handoff':handoff}

def publish(r):
    # Serialize the complete check/write/receipt transaction for this idempotency key.
    if not isinstance(r,dict) or not isinstance(r.get('idempotency_key'),str) or not SAFE_ID.fullmatch(r['idempotency_key']):
        raise ValueError('invalid idempotency_key')
    STATE_ROOT.mkdir(parents=True,exist_ok=True,mode=0o700)
    # All requests share one checkout. Hold its lock across the complete
    # fetch/check/write/push/receipt transaction, then take the per-key lock.
    # Every caller uses this order, including pending and legacy verification.
    flags=os.O_RDWR|os.O_CREAT|os.O_NOFOLLOW
    repository_fd=os.open(STATE_ROOT/'repository.lock',flags,0o600)
    with os.fdopen(repository_fd,'r+') as repository_lock:
        fcntl.flock(repository_lock,fcntl.LOCK_EX)
        lock_path=STATE_ROOT/f"{r['idempotency_key']}.lock"
        fd=os.open(lock_path,flags,0o600)
        with os.fdopen(fd,'r+') as lock:
            fcntl.flock(lock,fcntl.LOCK_EX)
            return _publish_locked(r)

def main():
    parser=argparse.ArgumentParser(); parser.add_argument('--request',required=True); args=parser.parse_args(); path=Path(args.request)
    if not path.is_file() or path.is_symlink(): raise SystemExit('invalid publication request')
    print(json.dumps(publish(json.loads(path.read_text(encoding='utf-8'))),sort_keys=True))

if __name__=='__main__': main()
