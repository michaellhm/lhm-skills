#!/usr/bin/env python3
"""Root-owned, repository-scoped HTML prototype publisher."""
import argparse, hashlib, json, os, re, shutil, subprocess, time, urllib.request
from pathlib import Path

REPOSITORY='michaellhm/lhm-prototype'; BRANCH='main'
REMOTE='ssh://git@ssh.github.com:443/michaellhm/lhm-prototype.git'
PUBLIC_ROOT='https://lhmstaging.net/prototypes/'
SSH_KEY=Path('/etc/lhm-prototype-publisher/id_ed25519')
KNOWN_HOSTS=Path('/etc/lhm-prototype-publisher/known_hosts')
CHECKOUT=Path('/srv/lhm-prototype-publisher/lhm-prototype')
SOURCE_ROOT=Path('/var/lib/lhm-prototype-publication/incoming')
WORKFLOW={'name':'Deploy to lhmstaging','id':289562388,'path':'.github/workflows/deploy.yml'}
SAFE_ID=re.compile(r'^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$'); SHA40=re.compile(r'^[0-9a-f]{40}$'); SHA256=re.compile(r'^[0-9a-f]{64}$')
PUBLISH_PATH=re.compile(r'^[a-z0-9][a-z0-9-]{0,62}/(?:sitemap|homepage)/index\.html$')
SENSITIVE=re.compile(r'(BEGIN [A-Z ]*PRIVATE KEY|github_pat_|ghp_|sk-)')

def run(args, *, env=None):
    return subprocess.run(args,check=True,capture_output=True,text=True,env=env).stdout.strip()

def git(*args, env=None):
    return run(['git','-c',f'safe.directory={CHECKOUT}','-C',str(CHECKOUT),*args],env=env)

def canonical_manifest(manifest):
    return json.dumps(manifest,sort_keys=True,separators=(',',':')).encode()

def file_digest(path):
    digest=hashlib.sha256(); size=0
    with path.open('rb') as handle:
        for chunk in iter(lambda:handle.read(65536),b''): digest.update(chunk); size+=len(chunk)
    return size,digest.hexdigest()

def validate(r):
    fields={'schema_version','request_id','repository','branch','expected_base_commit','source_directory','manifest','package_manifest_sha256','commit_message','workflow'}
    if not isinstance(r,dict) or set(r)!=fields or r.get('schema_version')!=1: raise ValueError('invalid prototype publication request schema')
    if not isinstance(r['request_id'],str) or not SAFE_ID.fullmatch(r['request_id']): raise ValueError('invalid request_id')
    if r['repository']!=REPOSITORY or r['branch']!=BRANCH: raise ValueError('repository and branch are not allowlisted')
    if not isinstance(r['expected_base_commit'],str) or not SHA40.fullmatch(r['expected_base_commit']): raise ValueError('invalid expected_base_commit')
    if r['workflow']!=WORKFLOW: raise ValueError('workflow identity does not match the reviewed deployment route')
    source=Path(r['source_directory']); expected=(SOURCE_ROOT/r['request_id']).resolve()
    if source.resolve()!=expected or source.parent.resolve()!=SOURCE_ROOT.resolve() or not source.is_dir() or source.is_symlink(): raise ValueError('invalid source_directory')
    manifest=r['manifest']
    if not isinstance(manifest,list) or not manifest or len(manifest)>100: raise ValueError('manifest must contain 1..100 entries')
    paths=[]
    for entry in manifest:
        if not isinstance(entry,dict) or set(entry)!={'path','sha256','bytes'}: raise ValueError('invalid manifest entry schema')
        value=entry['path']
        if not isinstance(value,str) or not PUBLISH_PATH.fullmatch(value): raise ValueError(f'path is outside prototype allowlist: {value}')
        if not isinstance(entry['sha256'],str) or not SHA256.fullmatch(entry['sha256']) or not isinstance(entry['bytes'],int) or isinstance(entry['bytes'],bool) or not 1<=entry['bytes']<=2_000_000: raise ValueError('invalid manifest evidence')
        candidate=source/value
        if candidate.is_symlink() or not candidate.is_file() or candidate.resolve().parent!=(source/Path(value).parent).resolve(): raise ValueError(f'invalid source file: {value}')
        size,digest=file_digest(candidate)
        if (size,digest)!=(entry['bytes'],entry['sha256']): raise ValueError(f'source evidence mismatch: {value}')
        if SENSITIVE.search(candidate.read_text(encoding='utf-8',errors='ignore')): raise ValueError(f'sensitive content detected: {value}')
        paths.append(value)
    if paths!=sorted(set(paths)): raise ValueError('manifest paths must be sorted and unique')
    # The package digest is produced by the root-side canonical package builder. File bytes are
    # independently verified above; the digest is retained unchanged in the immutable result.
    if not isinstance(r['package_manifest_sha256'],str) or not SHA256.fullmatch(r['package_manifest_sha256']): raise ValueError('invalid package manifest digest')
    if not isinstance(r['commit_message'],str) or not re.fullmatch(r'prototype: [A-Za-z0-9][A-Za-z0-9 ._:/()-]{0,120}',r['commit_message']): raise ValueError('invalid bounded commit message')

def ssh_env():
    if not SSH_KEY.is_file() or not KNOWN_HOSTS.is_file(): raise ValueError('prototype publisher credential is not configured')
    env=os.environ.copy(); env['GIT_SSH_COMMAND']=f'/usr/bin/ssh -i {SSH_KEY} -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile={KNOWN_HOSTS}'
    return env

def public_url(path):
    return PUBLIC_ROOT+path.removesuffix('index.html')

def verify_public(entry):
    url=public_url(entry['path']); req=urllib.request.Request(url,method='GET',headers={'User-Agent':'LHM-Prototype-Publisher/1'})
    with urllib.request.urlopen(req,timeout=20) as response:
        body=response.read(2_000_001)
        if response.status!=200 or not body or len(body)>2_000_000: raise ValueError(f'public prototype verification failed: {url}')
    digest=hashlib.sha256(body).hexdigest()
    if len(body)!=entry['bytes'] or digest!=entry['sha256']: raise ValueError(f'public prototype content does not match package: {url}')
    return {'url':url,'status':200,'bytes':len(body),'sha256':digest}

def publish(r):
    validate(r); env=ssh_env(); git('fetch',REMOTE,BRANCH,env=env)
    if git('rev-parse','FETCH_HEAD')!=r['expected_base_commit']: raise ValueError('main moved since authority was recorded; refusing publication')
    git('reset','--hard',r['expected_base_commit']); git('clean','-fd'); source=Path(r['source_directory'])
    paths=[entry['path'] for entry in r['manifest']]
    for value in paths:
        destination=CHECKOUT/value; destination.parent.mkdir(parents=True,exist_ok=True); shutil.copyfile(source/value,destination)
    changed=git('status','--porcelain=v1','-z','--untracked-files=all').split('\0')
    actual=sorted(line[3:] for line in changed if line)
    if actual!=paths: raise ValueError('checkout changes do not match approved manifest')
    git('add','--',*paths); git('-c','user.name=LHM Prototype Publisher','-c','user.email=prototype-publisher@localhealthmarketing.com.au','commit','-m',r['commit_message'])
    commit=git('rev-parse','HEAD'); git('push',REMOTE,f'{commit}:refs/heads/main',env=env)
    remote=run(['git','ls-remote',REMOTE,'refs/heads/main'],env=env).split()
    if len(remote)!=2 or remote[0]!=commit: raise ValueError('exact main commit verification failed')
    runs=[]
    for _ in range(30):
        actions=json.loads(run(['/usr/bin/gh','api',f'repos/{REPOSITORY}/actions/workflows/{WORKFLOW["id"]}/runs?head_sha={commit}&branch=main&per_page=1']))
        runs=actions.get('workflow_runs',[])
        if len(runs)==1 and runs[0].get('head_sha')==commit and runs[0].get('name')==WORKFLOW['name'] and runs[0].get('path')==WORKFLOW['path'] and runs[0].get('status')=='completed': break
        time.sleep(10)
    if len(runs)!=1 or runs[0].get('head_sha')!=commit or runs[0].get('name')!=WORKFLOW['name'] or runs[0].get('path')!=WORKFLOW['path'] or runs[0].get('status')!='completed' or runs[0].get('conclusion')!='success': raise ValueError('reviewed GitHub workflow has not successfully completed for exact commit')
    public=[verify_public(entry) for entry in r['manifest']]
    return {'schema_version':1,'status':'published_and_verified','request_id':r['request_id'],'repository':REPOSITORY,'branch':BRANCH,'base_commit':r['expected_base_commit'],'commit':commit,'package_manifest_sha256':r['package_manifest_sha256'],'workflow':{**WORKFLOW,'run_id':runs[0]['id'],'conclusion':'success'},'public_verifications':public,'changed_files':paths}

def main():
    parser=argparse.ArgumentParser(); parser.add_argument('--request',required=True); args=parser.parse_args(); path=Path(args.request)
    if not path.is_file() or path.is_symlink(): raise SystemExit('invalid publication request')
    print(json.dumps(publish(json.loads(path.read_text(encoding='utf-8')))))

if __name__=='__main__': main()
