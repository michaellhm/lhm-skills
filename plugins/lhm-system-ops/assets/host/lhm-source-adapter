#!/usr/bin/env python3
"""Bounded adapters for registered source retrieval, production and Drive publication."""
import hashlib, json, os, pwd, subprocess, sys
from pathlib import Path

CONFIG = Path(os.environ.get("LHM_SOURCE_ADAPTER_CONFIG", "/etc/lhm-source-production/adapters.json"))
REGISTRY = Path(os.environ.get("LHM_SOURCE_REGISTRY", "/etc/lhm-source-production/registrations"))
NAMES = {"lhm-claude-drive-read": "drive_read", "lhm-fathom-transcript-read": "fathom_read",
         "lhm-campaign-production-worker": "production", "lhm-registered-drive-publisher": "drive_publish"}
ALLOWED_CONFIG = {"schema_version", "backends"}
ALLOWED_BACKENDS = set(NAMES.values())
FATHOM_BACKEND = ["/usr/bin/sudo", "-n", "/usr/local/libexec/lhm-evidence-fathom-backend"]

def fail(message):
    print(message, file=sys.stderr)
    raise SystemExit(1)

def read_json(path):
    return json.loads(path.read_text(encoding="utf-8"))

def config():
    try: value = read_json(CONFIG)
    except Exception as exc: fail(f"adapter configuration unavailable: {exc}")
    if set(value) != ALLOWED_CONFIG or value.get("schema_version") != 1 or set(value.get("backends", {})) != ALLOWED_BACKENDS:
        fail("invalid adapter configuration")
    for name, command in value["backends"].items():
        if not isinstance(command, list) or not command or any(not isinstance(x, str) or not x for x in command): fail(f"invalid {name} backend command")
        executable = Path(command[0])
        if not executable.is_absolute() or not executable.is_file() or not os.access(executable, os.X_OK): fail(f"unresolved {name} backend executable")
    if value["backends"]["fathom_read"] != FATHOM_BACKEND: fail("fathom backend is not the bounded privilege bridge")
    return value

def call(command, payload):
    done = subprocess.run(command, input=json.dumps(payload).encode(), capture_output=True, timeout=120)
    # Backend diagnostics can contain connector material; never relay them to logs.
    if done.returncode: fail("backend command failed")
    return done.stdout

def registration(run_id):
    if not isinstance(run_id, str) or not run_id or "/" in run_id: fail("invalid run_id")
    try: return read_json(REGISTRY / (run_id + ".json"))
    except Exception as exc: fail(f"registration unavailable: {exc}")

def registered_source(reg, kind, identifier):
    if not any(x.get("kind") == kind and x.get("identifier") == identifier for x in reg.get("sources", [])): fail("source is not registered")

def main():
    name = Path(sys.argv[0]).name
    if name == "lhm-source-adapter" and len(sys.argv) > 1 and sys.argv[1] == "--validate-config":
        config(); print('{"configuration":"valid"}'); return
    if name == "lhm-source-adapter" and len(sys.argv) > 1 and sys.argv[1] == "--preflight":
        cfg = config()
        try: worker_uid = pwd.getpwnam("sourceworker").pw_uid
        except KeyError: fail("sourceworker account is absent")
        if worker_uid == 0 or os.geteuid() != worker_uid: fail("preflight must run as unprivileged sourceworker")
        payload = json.load(sys.stdin); reg = registration(payload.get("run_id"))
        for source in payload.get("sources", []):
            kind, identifier = source.get("kind"), source.get("allowlisted_identifier")
            registered_source(reg, kind, identifier)
            backend = "drive_read" if kind == "google_drive_file" else "fathom_read" if kind == "fathom_transcript" else fail("unsupported source kind")
            response = json.loads(call(cfg["backends"][backend], {"action":"probe", "identifier":identifier, "run_id":payload["run_id"]}))
            if response != {"authenticated": True, "capability": "read", "identifier_accessible": True}: fail(f"{backend} capability probe failed")
        destination = payload.get("production", {}).get("destination_allowlisted_identifier")
        if destination != reg.get("destination_identifier"): fail("destination is not registered")
        response = json.loads(call(cfg["backends"]["drive_publish"], {"action":"probe", "identifier":destination, "run_id":payload["run_id"]}))
        if response != {"authenticated": True, "capability": "publish_readback", "identifier_accessible": True}: fail("Drive publisher capability probe failed")
        response = json.loads(call(cfg["backends"]["production"], {"action":"probe", "run_id":payload["run_id"]}))
        if response != {"capability": "campaign_playbook_production", "ready": True}: fail("production capability probe failed")
        print('{"preflight":"ok"}')
        return
    if name not in NAMES: fail("unknown adapter invocation")
    cfg = config(); payload = json.load(sys.stdin); route = NAMES[name]
    if route in ("drive_read", "fathom_read"):
        reg = registration(payload.get("run_id")); kind = "google_drive_file" if route == "drive_read" else "fathom_transcript"
        registered_source(reg, kind, payload.get("identifier")); sys.stdout.buffer.write(call(cfg["backends"][route], {"action":"read", **payload})); return
    if route == "production":
        if payload.get("package_type") != "verified_evidence" or not payload.get("package_sha256"): fail("unverified evidence package")
        sys.stdout.buffer.write(call(cfg["backends"][route], {"action":"produce", "package":payload})); return
    destination, content, run_id = payload.get("destination_identifier"), payload.get("content"), payload.get("run_id")
    reg = registration(run_id)
    if destination != reg.get("destination_identifier") or not isinstance(content, str): fail("unregistered or invalid publication")
    key = hashlib.sha256((run_id + "\0" + destination + "\0" + content).encode()).hexdigest()
    call(cfg["backends"][route], {"action":"upsert", "identifier":destination, "content":content, "idempotency_key":key, "run_id":run_id})
    result = json.loads(call(cfg["backends"][route], {"action":"read", "identifier":destination, "run_id":run_id}))
    if result.get("full_content") != content: fail("Drive full-content read-back mismatch")
    print(json.dumps({"full_content":content, "idempotency_key":key}, separators=(",", ":")))

if __name__ == "__main__": main()
