#!/usr/bin/env python3
"""Root-owned, single-purpose ASP sitemap publisher and verifier."""
import argparse, json, os, re, shutil, subprocess, time, urllib.request
from pathlib import Path

REPOSITORY='michaellhm/lhm-prototype'; BRANCH='main'
REMOTE='ssh://git@ssh.github.com:443/michaellhm/lhm-prototype.git'
PUBLIC_URL='https://lhmstaging.net/prototypes/australian-sports-physio/sitemap/'
PATH_PREFIX='australian-sports-physio/sitemap/'
INDEX_PATHS={'README.md','australian-sports-physio/README.md'}
SSH_KEY=Path('/etc/lhm-asp-publisher/id_ed25519'); KNOWN_HOSTS=Path('/etc/lhm-asp-publisher/known_hosts')
CHECKOUT=Path('/srv/lhm-asp-publisher/lhm-prototype')
SOURCE_ROOT=Path('/var/lib/lhm-asp-publication/incoming')
SAFE_ID=re.compile(r'^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$'); SHA=re.compile(r'^[0-9a-f]{40}$')
SENSITIVE=re.compile(r'(BEGIN [A-Z ]*PRIVATE KEY|github_pat_|ghp_|sk-)')

def run(args, *, env=None):
    return subprocess.run(args,check=True,capture_output=True,text=True,env=env).stdout.strip()

def git(*args, env=None):
    return run(['git','-c',f'safe.directory={CHECKOUT}','-C',str(CHECKOUT),*args],env=env)

def validate(r):
    fields={'schema_version','request_id','repository','branch','expected_base_commit','source_directory','paths','commit_message'}
    if not isinstance(r,dict) or set(r)!=fields or r.get('schema_version')!=1: raise ValueError('invalid ASP publication request schema')
    if not isinstance(r['request_id'],str) or not SAFE_ID.fullmatch(r['request_id']): raise ValueError('invalid request_id')
    if r['repository']!=REPOSITORY or r['branch']!=BRANCH: raise ValueError('repository and branch are not allowlisted')
    if not isinstance(r['expected_base_commit'],str) or not SHA.fullmatch(r['expected_base_commit']): raise ValueError('invalid expected_base_commit')
    source=Path(r['source_directory'])
    expected_source=(SOURCE_ROOT/r['request_id']).resolve()
    if source.resolve()!=expected_source or source.parent.resolve()!=SOURCE_ROOT.resolve() or not source.is_dir() or source.is_symlink(): raise ValueError('invalid source_directory')
    paths=r['paths']
    if not isinstance(paths,list) or not paths or paths!=sorted(set(paths)): raise ValueError('paths must be a non-empty sorted unique list')
    index_count=0
    for value in paths:
        path=Path(value)
        if not isinstance(value,str) or path.is_absolute() or '..' in path.parts: raise ValueError(f'unsafe path: {value}')
        if value in INDEX_PATHS: index_count+=1
        elif not value.startswith(PATH_PREFIX): raise ValueError(f'path is outside ASP sitemap allowlist: {value}')
        candidate=source/value
        if candidate.resolve().parent != (source/path.parent).resolve() or not candidate.is_file() or candidate.is_symlink() or candidate.stat().st_size>2_000_000: raise ValueError(f'invalid source file: {value}')
        if SENSITIVE.search(candidate.read_text(encoding='utf-8',errors='ignore')): raise ValueError(f'sensitive content detected: {value}')
    if index_count>1: raise ValueError('only one minimum README/index link update is permitted')
    if not isinstance(r['commit_message'],str) or not r['commit_message'].startswith('asp sitemap: '): raise ValueError('invalid bounded commit message')

def ssh_env():
    if not SSH_KEY.is_file() or not KNOWN_HOSTS.is_file(): raise ValueError('ASP publisher credential is not configured')
    env=os.environ.copy()
    env['GIT_SSH_COMMAND']=f'/usr/bin/ssh -i {SSH_KEY} -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile={KNOWN_HOSTS}'
    return env

def verify_public_url(commit):
    req=urllib.request.Request(PUBLIC_URL,method='GET',headers={'User-Agent':'LHM-ASP-Publisher/1'})
    with urllib.request.urlopen(req,timeout=20) as response:
        body=response.read(2_000_001)
        if response.status!=200 or not body or len(body)>2_000_000: raise ValueError('public ASP sitemap verification failed')
    return {'url':PUBLIC_URL,'status':200,'bytes':len(body),'commit':commit}

def publish(r):
    validate(r); env=ssh_env(); git('fetch',REMOTE,BRANCH,env=env)
    if git('rev-parse','FETCH_HEAD')!=r['expected_base_commit']: raise ValueError('main moved since approval; refusing publication')
    git('reset','--hard',r['expected_base_commit']); source=Path(r['source_directory'])
    for value in r['paths']:
        destination=CHECKOUT/value; destination.parent.mkdir(parents=True,exist_ok=True); shutil.copyfile(source/value,destination)
    changed=git('status','--porcelain=v1','-z','--untracked-files=all').split('\0')
    paths=sorted(line[3:] for line in changed if line)
    if paths!=r['paths']: raise ValueError('checkout changes do not match approved paths')
    git('add','--',*paths); git('-c','user.name=LHM ASP Publisher','-c','user.email=asp-publisher@localhealthmarketing.com.au','commit','-m',r['commit_message'])
    commit=git('rev-parse','HEAD'); git('push',REMOTE,f'{commit}:refs/heads/main',env=env)
    remote=run(['git','ls-remote',REMOTE,'refs/heads/main'],env=env).split()
    if len(remote)!=2 or remote[0]!=commit: raise ValueError('exact main commit verification failed')
    runs=[]
    for _ in range(30):
        actions=json.loads(run(['/usr/bin/gh','api',f'repos/{REPOSITORY}/actions/runs?head_sha={commit}&per_page=1']))
        runs=actions.get('workflow_runs',[])
        if len(runs)==1 and runs[0].get('head_sha')==commit and runs[0].get('status')=='completed': break
        time.sleep(10)
    if len(runs)!=1 or runs[0].get('head_sha')!=commit or runs[0].get('status')!='completed' or runs[0].get('conclusion')!='success': raise ValueError('GitHub Actions has not successfully completed for exact commit')
    public=verify_public_url(commit)
    return {'status':'published_and_verified','repository':REPOSITORY,'branch':BRANCH,'commit':commit,'actions_run_id':runs[0]['id'],'actions_conclusion':'success','public_verification':public,'changed_files':paths}

def main():
    parser=argparse.ArgumentParser(); parser.add_argument('--request',required=True); args=parser.parse_args(); path=Path(args.request)
    if not path.is_file() or path.is_symlink(): raise SystemExit('invalid publication request')
    print(json.dumps(publish(json.loads(path.read_text(encoding='utf-8')))))

if __name__=='__main__': main()
