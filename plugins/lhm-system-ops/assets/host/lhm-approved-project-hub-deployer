#!/usr/bin/env python3
"""Approval-bound immutable installer and rollback for lhm-project-hub."""
import argparse
import hmac
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import tempfile
import zipfile
from datetime import datetime, timezone
from pathlib import Path

REPO = Path('/srv/lhm-plugin-release-source/project-hub-0.1.80')
APPROVALS = Path('/etc/lhm-plugin-approvals')
APPROVAL_KEY = APPROVALS / 'project-hub-approval.key'
USED_NONCES = Path('/var/lib/lhm-plugin-approval-nonces/lhm-project-hub')
ARCHIVES = Path('/var/lib/lhm-plugin-releases')
PROFILE = Path('/home/hermes/.hermes/profiles/lhm_brain')
RELEASE_ROOT = Path('/opt/lhm-plugin-releases')
RELEASES = RELEASE_ROOT / 'lhm-project-hub'
CURRENT = RELEASE_ROOT / 'current/lhm-project-hub'
VISIBLE_ROOT = Path('/home/hermes/.hermes/immutable-plugin-releases')
VISIBLE_CURRENT = VISIBLE_ROOT / 'current/lhm-project-hub'
CONTAINER_VISIBLE_ROOT = Path('/opt/data/immutable-plugin-releases')
MOUNTINFO = Path('/proc/self/mountinfo')
BACKUPS = Path('/var/backups/lhm-plugin-deployments')
REPOSITORY = 'michaellhm/lhm-skills'
PLUGIN = 'lhm-project-hub'
VERSION = '0.1.80'


def now(): return datetime.now(timezone.utc)
def digest(path): return hashlib.sha256(path.read_bytes()).hexdigest()
def git(*args):
    return subprocess.run(['git', '-C', str(REPO), *args], check=True,
                          capture_output=True, text=True).stdout.strip()


def safe_id(value):
    return isinstance(value, str) and value and all(c.isalnum() or c in '._:-' for c in value)


def secure_root_file(path, mode=0o600):
    if not path.is_file() or path.is_symlink(): raise SystemExit(f'insecure or missing root file: {path}')
    state = path.stat()
    if state.st_uid != 0 or state.st_mode & 0o777 != mode:
        raise SystemExit(f'invalid root file owner or mode: {path}')


def secure_root_directory(path, uid=0):
    if not path.is_dir() or path.is_symlink(): raise SystemExit(f'insecure root directory: {path}')
    state = path.stat()
    if state.st_uid != uid or state.st_mode & 0o022:
        raise SystemExit(f'root directory is writable by a non-root principal: {path}')


def reject_symlink_components(path):
    current = path.absolute()
    while current != current.parent:
        if current.is_symlink(): raise SystemExit(f'linked path component is prohibited: {current}')
        current = current.parent


def secure_root_ancestors(path, stop, uid=0):
    path=path.absolute(); stop=stop.absolute()
    try: path.relative_to(stop)
    except ValueError: raise SystemExit('secure path escapes governed root')
    current=path
    while True:
        secure_root_directory(current,uid=uid)
        if current == stop: break
        current=current.parent


def mount_is_read_only(path, mountinfo=MOUNTINFO):
    expected=str(path.absolute())
    matches=[]
    for line in mountinfo.read_text().splitlines():
        left=line.split(' - ',1)[0].split()
        if len(left)>5 and left[4].replace('\\040',' ')==expected:
            matches.append(left[5].split(','))
    return len(matches)==1 and 'ro' in matches[0]


def secure_container_mount():
    result=subprocess.run(['docker','inspect','--format','{{json .Mounts}}','hermes'],check=True,capture_output=True,text=True)
    mounts=json.loads(result.stdout)
    valid=[m for m in mounts if m.get('Type')=='bind' and m.get('Source')==str(RELEASE_ROOT)
           and m.get('Destination')==str(CONTAINER_VISIBLE_ROOT) and m.get('RW') is False]
    if len(valid)!=1: raise SystemExit('Hermes immutable release read-only bind is absent or ambiguous')


def secure_release_boundary():
    reject_symlink_components(RELEASE_ROOT); reject_symlink_components(VISIBLE_ROOT)
    secure_root_ancestors(RELEASE_ROOT, Path('/opt'))
    secure_root_directory(RELEASES); secure_root_directory(CURRENT.parent)
    secure_root_directory(VISIBLE_ROOT)
    # Same-filesystem bind mounts can report False from os.path.ismount() because
    # the bind target and its parent share a device. The exact mountinfo target,
    # read-only flag, and source inode/device checks below are authoritative.
    if not mount_is_read_only(VISIBLE_ROOT):
        raise SystemExit('host immutable release alias is not a read-only mount')
    source=RELEASE_ROOT.stat(); visible=VISIBLE_ROOT.stat()
    if (source.st_dev,source.st_ino)!=(visible.st_dev,visible.st_ino):
        raise SystemExit('host immutable release alias has the wrong source')
    reject_symlink_components(PROFILE / 'skills'); reject_symlink_components(PROFILE / 'plugin-sources')
    secure_container_mount()


def signed_payload(value):
    return json.dumps({key: item for key, item in value.items() if key != 'signature'},
                      sort_keys=True, separators=(',', ':')).encode()


def verify_signature(value):
    secure_root_directory(APPROVALS)
    secure_root_file(APPROVAL_KEY)
    key = APPROVAL_KEY.read_bytes()
    if len(key) < 32: raise SystemExit('approval authentication key is too short')
    expected = hmac.new(key, signed_payload(value), hashlib.sha256).hexdigest()
    if not hmac.compare_digest(expected, str(value.get('signature', ''))):
        raise SystemExit('approval signature mismatch')


def sign_approval(approval_id):
    if not safe_id(approval_id): raise SystemExit('invalid approval_id')
    path = APPROVALS / f'{approval_id}.json'; secure_root_directory(APPROVALS); secure_root_file(path)
    value = json.loads(path.read_text())
    if value.get('approval_id') != approval_id or value.get('signature') not in {'', None}:
        raise SystemExit('approval is already signed or has the wrong identity')
    secure_root_file(APPROVAL_KEY); key = APPROVAL_KEY.read_bytes()
    if len(key) < 32: raise SystemExit('approval authentication key is too short')
    value['signature'] = hmac.new(key, signed_payload(value), hashlib.sha256).hexdigest()
    atomic_json(path, value)
    print(json.dumps({'status':'signed','approval_id':approval_id,'nonce':value.get('nonce')}))


def secure_nonce_directory(path):
    state = path.stat()
    if state.st_uid != 0 or state.st_mode & 0o077:
        raise SystemExit('approval nonce ledger is not root-private')
def claim_nonce(value):
    USED_NONCES.mkdir(parents=True, mode=0o700, exist_ok=True)
    secure_nonce_directory(USED_NONCES)
    receipt = USED_NONCES / value['nonce']
    try:
        fd = os.open(receipt, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0), 0o600)
    except FileExistsError:
        raise SystemExit('approval nonce already consumed')
    with os.fdopen(fd, 'w', encoding='utf-8') as handle:
        json.dump({'approval_id': value['approval_id'], 'action': value['action'],
                   'approval_sha256': hashlib.sha256(signed_payload(value)).hexdigest(),
                   'claimed_at': now().isoformat()}, handle, sort_keys=True)
        handle.write('\n'); handle.flush(); os.fsync(handle.fileno())


def atomic_json(path, value):
    fd, temporary = tempfile.mkstemp(prefix=f'.{path.name}.', dir=path.parent)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            json.dump(value, handle, indent=2, sort_keys=True); handle.write('\n')
            handle.flush(); os.fsync(handle.fileno())
        os.chmod(temporary, 0o600); os.replace(temporary, path)
    finally:
        if os.path.exists(temporary): os.unlink(temporary)


def atomic_symlink(target, link):
    link.parent.mkdir(parents=True, exist_ok=True)
    temporary = link.parent / f'.{link.name}.{os.getpid()}.new'
    if temporary.exists() or temporary.is_symlink(): temporary.unlink()
    linked_target = os.path.relpath(target, link.parent) if isinstance(target, Path) and target.is_absolute() else target
    temporary.symlink_to(linked_target)
    os.replace(temporary, link)


def validate_archive(archive, staging):
    with zipfile.ZipFile(archive) as bundle:
        members = bundle.infolist()
        if not members or len(members) > 500 or sum(x.file_size for x in members) > 10_000_000:
            raise ValueError('plugin archive exceeds size or file-count ceiling')
        prefix = f'{PLUGIN}/'
        for item in members:
            mode = (item.external_attr >> 16) & 0o170000
            if mode == 0o120000:
                raise ValueError('plugin archive symlink is prohibited')
            path = Path(item.filename)
            if not item.filename.startswith(prefix) or '..' in path.parts or path.is_absolute():
                raise ValueError('unsafe plugin archive path')
        bundle.extractall(staging)
    plugin = staging / PLUGIN
    manifest = json.loads((plugin / '.claude-plugin/plugin.json').read_text())
    if manifest.get('name') != PLUGIN or manifest.get('version') != VERSION:
        raise ValueError('plugin identity or version mismatch')
    skills = sorted(p.parent.name for p in (plugin / 'skills').glob('*/SKILL.md'))
    if not skills or len(skills) != len(set(skills)):
        raise ValueError('plugin contains no unique skills')
    return plugin, skills


def verify_existing_release(release, expected, uid=0):
    release_state=release.lstat() if release.exists() or release.is_symlink() else None
    if (release_state is None or not stat.S_ISDIR(release_state.st_mode) or release.is_symlink()
            or release_state.st_uid != uid or release_state.st_mode & 0o022):
        raise SystemExit('existing release is not a secure directory')
    actual_members={Path('.')}; expected_members={Path('.')}
    for root, members, required_uid in ((release,actual_members,uid),(expected,expected_members,None)):
        for item in root.rglob('*'):
            relative=item.relative_to(root); state=item.lstat()
            if stat.S_ISLNK(state.st_mode) or not (stat.S_ISDIR(state.st_mode) or stat.S_ISREG(state.st_mode)):
                raise SystemExit('release tree contains a link or special file')
            if required_uid is not None and (state.st_uid != required_uid or state.st_mode & 0o022):
                raise SystemExit('existing release member has unsafe ownership or mode')
            if stat.S_ISREG(state.st_mode) and state.st_nlink != 1:
                raise SystemExit('release tree contains a hard-linked file')
            members.add(relative)
    if actual_members != expected_members:
        raise SystemExit('existing release member set differs from approved archive')
    for relative in expected_members-{Path('.')}:
        actual=release/relative; wanted=expected/relative
        if actual.is_dir() != wanted.is_dir():
            raise SystemExit('existing release member type differs from approved archive')
        if actual.is_file() and (actual.stat().st_size != wanted.stat().st_size or digest(actual) != digest(wanted)):
            raise SystemExit('existing release bytes differ from approved archive')


def seal_release(release, uid=0):
    for item in release.rglob('*'):
        state=item.lstat()
        if stat.S_ISLNK(state.st_mode) or not (stat.S_ISDIR(state.st_mode) or stat.S_ISREG(state.st_mode)):
            raise SystemExit('release link or special file is prohibited')
        if stat.S_ISREG(state.st_mode) and state.st_nlink != 1:
            raise SystemExit('release hard-linked file is prohibited')
        os.chmod(item, 0o555 if stat.S_ISDIR(state.st_mode) else 0o444); os.chown(item,uid,0 if uid == 0 else os.getgid())
    os.chmod(release,0o555); os.chown(release,uid,0 if uid == 0 else os.getgid())


def seal_and_reverify_release(release, expected, uid=0):
    seal_release(release,uid=uid)
    verify_existing_release(release,expected,uid=uid)


def snapshot(path, backup):
    if path.is_symlink(): return {'kind': 'symlink', 'target': os.readlink(path)}
    if path.exists():
        shutil.copytree(path, backup)
        return {'kind': 'directory', 'backup': str(backup)}
    return {'kind': 'absent'}


def restore(path, record):
    if path.exists() or path.is_symlink():
        if path.is_dir() and not path.is_symlink(): shutil.rmtree(path)
        else: path.unlink()
    if record['kind'] == 'symlink': atomic_symlink(record['target'], path)
    elif record['kind'] == 'directory': shutil.copytree(record['backup'], path)


def consume_approval(approval_id, action, archive_sha256, commit, backup=None):
    if not safe_id(approval_id): raise SystemExit('invalid approval_id')
    path = APPROVALS / f'{approval_id}.json'
    secure_root_file(path)
    value = json.loads(path.read_text())
    required = {'schema_version','approval_id','action','repository','commit','archive_sha256',
                'plugin','profile','issued_at','expires_at','nonce','used','signature'}
    allowed = required | ({'backup'} if action == 'rollback' else set())
    if value.get('schema_version') != 3 or set(value) != allowed:
        raise SystemExit('invalid approval schema')
    verify_signature(value)
    if value.get('approval_id') != approval_id or value.get('action') != action or value.get('used') is not False:
        raise SystemExit('approval scope or use mismatch')
    if value.get('repository') != REPOSITORY or value.get('plugin') != PLUGIN or value.get('profile') != 'lhm_brain':
        raise SystemExit('approval scope mismatch')
    try:
        issued = datetime.fromisoformat(value['issued_at']); expires = datetime.fromisoformat(value['expires_at'])
    except (TypeError, ValueError): raise SystemExit('invalid approval timestamps')
    current = now()
    if issued.tzinfo is None or expires.tzinfo is None or issued > current or expires <= current:
        raise SystemExit('approval is not currently valid')
    if (expires - issued).total_seconds() > 86400: raise SystemExit('approval validity exceeds 24 hours')
    if not re.fullmatch(r'[a-f0-9]{40}', str(value['commit'])):
        raise SystemExit('invalid approval commit')
    if not re.fullmatch(r'[a-f0-9]{64}', str(value['archive_sha256'])):
        raise SystemExit('invalid approval archive digest')
    if not isinstance(value['nonce'], str) or not re.fullmatch(r'[a-f0-9]{32,64}', value['nonce']):
        raise SystemExit('invalid approval nonce')
    if value['archive_sha256'] != archive_sha256 or value['commit'] != commit:
        raise SystemExit('approval release binding mismatch')
    if action == 'rollback' and Path(value['backup']).resolve() != backup.resolve(): raise SystemExit('rollback backup mismatch')
    claim_nonce(value)
    return value


def install(approval_id, archive):
    archive = archive.absolute()
    if archive.parent != ARCHIVES or not archive.is_file() or archive.is_symlink():
        raise SystemExit('unapproved archive location')
    archive_sha256 = digest(archive)
    commit = git('rev-parse', 'HEAD')
    if git('status', '--porcelain'):
        raise SystemExit('source checkout is dirty or at the wrong commit')
    secure_release_boundary()
    release_id = archive_sha256
    release = RELEASES / release_id
    with tempfile.TemporaryDirectory(prefix='lhm-project-hub.') as temporary:
        plugin, skills = validate_archive(archive, Path(temporary))
        if release.exists() or release.is_symlink(): verify_existing_release(release,plugin)
        approval = consume_approval(approval_id, 'install', archive_sha256, commit)
        if release.exists():
            seal_and_reverify_release(release,plugin)
        else:
            RELEASES.mkdir(parents=True, exist_ok=True)
            staged = RELEASES / f'.{release_id}.new'
            shutil.copytree(plugin, staged); seal_and_reverify_release(staged,plugin); os.replace(staged, release)
    stamp = now().strftime('%Y%m%dT%H%M%SZ')
    backup = BACKUPS / f'{PLUGIN}-{stamp}-{approval["commit"][:12]}'
    backup.mkdir(parents=True, mode=0o700, exist_ok=False)
    records = {'schema_version': 1, 'plugin': PLUGIN, 'version': VERSION,
               'installed_commit': commit, 'installed_archive_sha256': archive_sha256,
               'current': snapshot(CURRENT, backup / 'current'), 'skills': {},
               'plugin_source': snapshot(PROFILE / 'plugin-sources' / PLUGIN, backup / 'plugin-source')}
    for name in skills:
        records['skills'][name] = snapshot(PROFILE / 'skills' / name, backup / f'skill-{name}')
    atomic_json(backup / 'rollback.json', records)
    atomic_symlink(release, CURRENT)
    for name in skills:
        atomic_symlink(VISIBLE_CURRENT / 'skills' / name, PROFILE / 'skills' / name)
    atomic_symlink(VISIBLE_CURRENT, PROFILE / 'plugin-sources' / PLUGIN)
    print(json.dumps({'status':'installed','plugin':PLUGIN,'version':VERSION,
                      'release':str(release),'backup':str(backup)}))


def rollback(approval_id, backup):
    if (backup.parent != BACKUPS or not backup.name.startswith(f'{PLUGIN}-')
            or not backup.is_dir() or backup.is_symlink()):
        raise SystemExit('rollback backup is outside the governed backup root')
    secure_release_boundary()
    state_file = backup / 'rollback.json'
    if not state_file.is_file() or state_file.is_symlink(): raise SystemExit('rollback state unavailable')
    state = json.loads(state_file.read_text())
    if set(state) != {'schema_version','plugin','version','installed_commit','installed_archive_sha256','current','skills','plugin_source'} or not isinstance(state['skills'], dict):
        raise SystemExit('invalid rollback state schema')
    if state['schema_version'] != 1 or state['plugin'] != PLUGIN or state['version'] != VERSION:
        raise SystemExit('rollback state identity mismatch')
    consume_approval(approval_id, 'rollback', state['installed_archive_sha256'],
                     state['installed_commit'], backup=backup)
    for name, record in state['skills'].items():
        if not safe_id(name) or record.get('kind') not in {'absent','symlink','directory'}:
            raise SystemExit('invalid rollback skill record')
    for record in [state['current'], state['plugin_source'], *state['skills'].values()]:
        if record.get('kind') == 'directory':
            saved = Path(record.get('backup', '')).resolve()
            try: saved.relative_to(backup.resolve())
            except ValueError: raise SystemExit('rollback content escapes governed backup')
            if not saved.is_dir() or saved.is_symlink(): raise SystemExit('rollback content unavailable')
    restore(CURRENT, state['current'])
    for name, record in state['skills'].items(): restore(PROFILE / 'skills' / name, record)
    restore(PROFILE / 'plugin-sources' / PLUGIN, state['plugin_source'])
    print(json.dumps({'status':'rolled_back','plugin':PLUGIN,'backup':str(backup)}))


def main():
    if os.geteuid() != 0: raise SystemExit('installer must run as root')
    parser = argparse.ArgumentParser(); sub = parser.add_subparsers(dest='action', required=True)
    ins = sub.add_parser('install'); ins.add_argument('approval_id'); ins.add_argument('archive', type=Path)
    rb = sub.add_parser('rollback'); rb.add_argument('approval_id'); rb.add_argument('backup', type=Path)
    sg = sub.add_parser('sign'); sg.add_argument('approval_id')
    args = parser.parse_args()
    if args.action == 'install': install(args.approval_id, args.archive)
    elif args.action == 'rollback': rollback(args.approval_id, args.backup.absolute())
    else: sign_approval(args.approval_id)


if __name__ == '__main__': main()
