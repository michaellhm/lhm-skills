#!/usr/bin/env python3
"""Complete bounded replacement for the root-owned Claude dispatcher."""
import json, os, subprocess, sys
from pathlib import Path

WORKER = "/usr/local/libexec/lhm-claude-worker"
PROFILES = {"google_drive_exact_file_read", "campaign_playbook_production", "google_drive_exact_folder_publish"}

def main():
    request = json.load(sys.stdin)
    if request.get("profile") not in PROFILES or request.get("schema_version") != 1:
        raise SystemExit("unregistered Claude gateway profile")
    if not Path(WORKER).is_file() or not os.access(WORKER, os.X_OK):
        raise SystemExit("verified Claude worker route absent")
    done = subprocess.run([WORKER], input=json.dumps(request).encode(), stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL, timeout=request.get("timeout_seconds", 120), check=False)
    if done.returncode: raise SystemExit("Claude worker failed")
    sys.stdout.buffer.write(done.stdout)
if __name__ == "__main__": main()
