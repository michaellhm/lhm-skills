#!/usr/bin/env python3
"""Additive dispatcher for the three evidence-only Claude profiles."""
import json
import os
import subprocess
import sys
from pathlib import Path

WORKER = "/usr/local/libexec/lhm-evidence-claude-worker"
RUNUSER = "/usr/sbin/runuser"
PROFILES = {
    "google_drive_exact_file_read",
    "campaign_playbook_production",
    "google_drive_exact_folder_publish",
}


def fail(message):
    print(message, file=sys.stderr)
    raise SystemExit(1)


def main():
    try:
        request = json.load(sys.stdin)
    except Exception:
        fail("invalid evidence gateway JSON")
    if len(sys.argv) == 2 and sys.argv[1] in PROFILES and isinstance(request, dict):
        request = {**request, "schema_version": 1, "profile": sys.argv[1]}
    if not isinstance(request, dict) or request.get("schema_version") != 1 or request.get("profile") not in PROFILES:
        fail("unregistered evidence gateway profile")
    if not Path(WORKER).is_file() or not os.access(WORKER, os.X_OK):
        fail("evidence Claude worker absent")
    command = [RUNUSER, "-u", "claudeworker", "--", WORKER] if os.geteuid() == 0 else [WORKER]
    try:
        done = subprocess.run(command, input=json.dumps(request).encode(), stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, timeout=request.get("timeout_seconds", 120) + 5)
    except (OSError, subprocess.TimeoutExpired):
        fail("evidence Claude worker failed")
    if done.returncode:
        fail("evidence Claude worker failed")
    sys.stdout.buffer.write(done.stdout)


if __name__ == "__main__":
    main()
