#!/usr/bin/env python3
"""Complete least-privilege Claude worker replacement; credentials remain in its HOME."""
import json, os, subprocess, sys
from pathlib import Path

CLAUDE = "/home/claudeworker/.local/bin/claude"
ALLOWED_TOOLS = {
 "google_drive_exact_file_read": ["mcp__claude_ai_Google_Drive__get_file_metadata","mcp__claude_ai_Google_Drive__read_file_content","mcp__claude_ai_Google_Drive__download_file_content"],
 "google_drive_exact_folder_publish": ["mcp__claude_ai_Google_Drive__search_files","mcp__claude_ai_Google_Drive__create_file","mcp__claude_ai_Google_Drive__get_file_metadata","mcp__claude_ai_Google_Drive__read_file_content","mcp__claude_ai_Google_Drive__download_file_content"],
 "campaign_playbook_production": [],
}

def main():
    request=json.load(sys.stdin); profile=request.get("profile")
    if profile not in ALLOWED_TOOLS: raise SystemExit("unregistered worker profile")
    if not Path(CLAUDE).is_file() or not os.access(CLAUDE, os.X_OK): raise SystemExit("Claude 2.1.232 executable absent")
    prompt=json.dumps(request,separators=(",",":"))
    command=[CLAUDE,"--print","--output-format","json","--agent",request.get("agent_id","")]
    if ALLOWED_TOOLS[profile]: command += ["--allowedTools", ",".join(ALLOWED_TOOLS[profile])]
    env={"HOME":"/home/claudeworker-repair","PATH":"/home/claudeworker/.local/bin:/usr/bin:/bin"}
    done=subprocess.run(command,input=prompt.encode(),stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,
                        env=env,timeout=request.get("timeout_seconds",120),check=False)
    if done.returncode: raise SystemExit("bounded Claude invocation failed")
    sys.stdout.buffer.write(done.stdout)
if __name__=="__main__": main()
