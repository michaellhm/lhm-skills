#!/usr/bin/env python3
import argparse,base64,hashlib,json,os,subprocess,sys,tempfile
from pathlib import Path
from lhm_workflow.org_routing import canonical,receipt

def main():
 p=argparse.ArgumentParser(); p.add_argument("owner"); p.add_argument("private_key",type=Path); p.add_argument("--verifier",action="store_true"); p.add_argument("--registry",type=Path); p.add_argument("--request",type=Path); p.add_argument("--result",type=Path); p.add_argument("--request-dir",type=Path); p.add_argument("--result-dir",type=Path); a=p.parse_args()
 if a.request_dir:
  candidates=sorted(a.request_dir.glob("*.json"));
  if not candidates: return
  a.request=candidates[0]; a.result=a.result_dir/a.request.name
 value=json.loads(a.request.read_text()) if a.request else json.load(sys.stdin); contract=value["contract"]
 if contract["owner"]!=a.owner: raise SystemExit("owner mismatch")
 st=a.private_key.stat(follow_symlinks=False)
 if a.private_key.is_symlink() or st.st_uid!=(os.getuid() if os.environ.get("LHM_WORKFLOW_TEST_MODE")=="1" else 0) or st.st_mode&0o077: raise SystemExit("unsafe private key")
 outputs=value["outputs"]
 if a.verifier:
  if contract["runtime"]!="verifier" or outputs!=contract["input_artifacts"] or a.registry is None: raise SystemExit("invalid verifier envelope")
  registry=json.loads(a.registry.read_text())
  for item in outputs:
   record=registry.get(item["artifact_id"]); path=Path(record["path"]) if record else None
   if not record or record["sha256"]!=item["sha256"] or hashlib.sha256(path.read_bytes()).hexdigest()!=item["sha256"]: raise SystemExit("verifier readback failed")
 unsigned=receipt(contract,outputs=outputs,checks=value["checks"],decision=value.get("decision")); unsigned.pop("attestation")
 fd,data_path=tempfile.mkstemp(prefix="lhm-role-data-")
 try:
  with os.fdopen(fd,"wb") as handle: handle.write(canonical(unsigned))
  done=subprocess.run(["openssl","pkeyutl","-sign","-inkey",str(a.private_key),"-rawin","-in",data_path],capture_output=True,check=True)
 finally: Path(data_path).unlink(missing_ok=True)
 unsigned["attestation"]={"algorithm":"ed25519","signature":base64.b64encode(done.stdout).decode()}
 if a.result:
  a.result.parent.mkdir(parents=True,exist_ok=True); a.result.write_text(json.dumps(unsigned,sort_keys=True,separators=(",",":"))+"\n"); a.result.chmod(0o640)
 else: print(json.dumps(unsigned,sort_keys=True,separators=(",",":")))
 if a.request_dir: a.request.unlink()
if __name__=="__main__": main()
