def canonical_client_handback_target(client):
    """Derive governed delivery scope from the canonical Google Ads client registry."""
    vault_prefix = client.get('evidence_prefix')
    folder_url = client.get('drive_folder_url')
    task_ids = client.get('basicops_task_ids', [])
    if (not isinstance(vault_prefix, str) or not vault_prefix.startswith('20 Clients/')
            or not vault_prefix.endswith('/') or '..' in Path(vault_prefix).parts):
        raise SystemExit('invalid canonical client vault prefix')
    if not isinstance(folder_url, str):
        raise SystemExit('canonical client Drive folder unavailable')
    match = re.fullmatch(r'https://drive\.google\.com/drive/folders/([A-Za-z0-9_-]{10,})/?', folder_url)
    if not match:
        raise SystemExit('invalid canonical client Drive folder URL')
    if (not isinstance(task_ids, list)
            or not all(isinstance(value, (str, int)) and re.fullmatch(r'[0-9]+', str(value)) for value in task_ids)):
        raise SystemExit('invalid canonical client BasicOps task allowlist')
    return {
        'name': client['name'],
        'vault_prefix': vault_prefix,
        'drive_folder_query': f'exact folder with folder ID {match.group(1)}',
        'basicops_task_ids': [str(value) for value in task_ids],
    }


def ensure_worker_traversal():
    subprocess.run([
        'systemd-run', '--quiet', '--wait', '--collect',
        f'--unit=lhm-dispatch-acl-{os.getpid()}',
        '/usr/bin/setfacl', '-m', 'm::--x,u:claudeworker:--x,u:codexworker:--x',
        *(str(path) for path in WORKER_TRAVERSAL_ANCESTORS)
    ], check=True)


def durable_supervisor_failure(run_dir, reason):
    """Persist an honest terminal state even when the worker loses traversal."""
    final_file = run_dir / 'final.json'
    if final_file.exists():
        return
    try:
        prompt = json.loads((run_dir / 'prompt.json').read_text(encoding='utf-8'))
    except (OSError, json.JSONDecodeError, TypeError):
        prompt = {}
    final = {
        'run_id': run_dir.name,
        'status': 'failed',
        'profile': prompt.get('profile', 'unknown'),
        'agent_id': prompt.get('agent_id', 'unknown'),
        'completed_at': datetime.now(timezone.utc).isoformat(),
        'error': reason,
    }
    final_file.write_text(json.dumps(final, indent=2) + '\n', encoding='utf-8')
    events = run_dir / 'events.jsonl'
    with events.open('a', encoding='utf-8') as handle:
        handle.write(json.dumps({
            'event': 'failed', 'run_id': run_dir.name,
            'summary': reason,
        }, separators=(',', ':')) + '\n')
    for item in (final_file, events):
        os.chown(item, WORKER_UID, HERMES_GID)
        os.chmod(item, 0o640)


def supervise_worker(run_dir, timeout_seconds):
    """Maintain the exact traversal ACL for the complete unprivileged worker run."""
    resolved = run_dir.resolve()
    try:
        resolved.relative_to(RUNS.resolve())
    except ValueError:
        raise SystemExit('supervisor run directory escapes the runs root')
    if resolved != run_dir or not run_dir.is_dir() or run_dir.is_symlink():
        raise SystemExit('supervisor requires an existing non-linked canonical run directory')
    ensure_worker_traversal()
    process = subprocess.Popen([
        '/usr/sbin/runuser', '--user', 'claudeworker', '--group', 'claudeworker', '--',
        '/usr/local/libexec/lhm-claude-worker', str(run_dir), str(timeout_seconds),
    ])
    acl_failure = None
    while process.poll() is None:
        try:
            ensure_worker_traversal()
        except subprocess.CalledProcessError:
            acl_failure = 'worker traversal ACL could not be maintained; run failed closed'
            process.terminate()
            break
        time.sleep(ACL_POLL_SECONDS)
    try:
        return_code = process.wait(timeout=10)
    except subprocess.TimeoutExpired:
        process.kill()
        return_code = process.wait()
    if acl_failure:
        durable_supervisor_failure(run_dir, acl_failure)
        return 1
    if return_code != 0:
        durable_supervisor_failure(run_dir, f'worker exited without a terminal artifact (exit {return_code})')
        return 1
    if not (run_dir / 'final.json').is_file():
        durable_supervisor_failure(run_dir, 'worker exited without a terminal artifact')
        return 1
    return 0


def configure_worker_run_dir(run_dir):
    """Keep the worker's private write access if the gateway re-owns the profile."""
    os.chown(run_dir, WORKER_UID, HERMES_GID)
    subprocess.run([
        '/usr/bin/setfacl', '-m', 'u:claudeworker:rwx', str(run_dir)
    ], check=True)


def reject(path, reason):
    target = FAILED / path.name
    shutil.move(str(path), target)
    error = FAILED / f'{path.stem}.error'
    error.write_text(reason + '\n', encoding='utf-8')
    os.chown(target, 0, HERMES_GID)
    os.chown(error, 0, HERMES_GID)
    os.chmod(target, 0o640)
    os.chmod(error, 0o640)


def process(path):
    try:
        request = json.loads(path.read_text(encoding='utf-8'))
    except Exception as exc:
        reject(path, f'invalid JSON: {exc}')
        return
    profile = request.get('profile')
    handback_profiles = {'google_drive_client_file_create', 'basicops_task_discussion_update'}
    contract_fields = {'workflow_id', 'required_skills', 'required_capabilities'}
    governed = isinstance(request.get('controller_child_run_id'), str)
    governed_fields = {'controller_child_run_id'} if governed else set()
    expected_fields = ({'schema_version', 'run_id', 'profile', 'agent_id', 'route', 'subject_name', 'objective', 'output_name', 'input_artifacts', 'timeout_seconds'} | contract_fields
                       if profile == 'html_artifact_producer' else
                       {'schema_version', 'run_id', 'profile', 'agent_id', 'client', 'artifact_path', 'file_name', 'timeout_seconds'} | contract_fields
                       if profile == 'google_drive_client_file_create' else
                       {'schema_version', 'run_id', 'profile', 'agent_id', 'client', 'task_id', 'discussion', 'timeout_seconds'} | contract_fields
                       if profile == 'basicops_task_discussion_update' else
                       {'schema_version', 'run_id', 'profile', 'agent_id', 'target_type', 'client', 'name', 'vault_prefix', 'drive_folder_id', 'basicops_task_ids', 'timeout_seconds'} | contract_fields
                       if profile == 'handback_target_registration' else
                       {'schema_version', 'run_id', 'profile', 'agent_id', 'route', 'subject_type', 'subject_name', 'objective', 'approval_state', 'timeout_seconds'} | contract_fields
                       if profile == 'specialist_readonly' else
                       {'schema_version', 'run_id', 'profile', 'agent_id', 'site', 'urls', 'objective', 'timeout_seconds'} | contract_fields
                       if profile == 'seo_gsc_readonly' else
                       {'schema_version', 'run_id', 'profile', 'agent_id', 'client', 'objective', 'timeout_seconds'} | contract_fields) | governed_fields
    if set(request) != expected_fields:
        reject(path, 'unexpected request fields')
        return
    expected_schema = 2 if profile == 'html_artifact_producer' else 1
    if request.get('schema_version') != expected_schema:
        reject(path, 'unsupported schema_version')
        return
    if profile not in {'google_ads_readonly', 'seo_gsc_readonly', 'marketing_orchestrator_readonly', 'handback_target_registration', 'specialist_readonly', 'html_artifact_producer'} | handback_profiles:
        reject(path, 'disallowed profile')
        return
    required_agent = (SPECIALIST_ROUTES.get(request.get('route'), (None, None))[0]
                      if profile in {'specialist_readonly', 'html_artifact_producer'} else {
        'google_ads_readonly': 'lhm-marketing-hub:google-ads',
        'seo_gsc_readonly': 'lhm-marketing-hub:seo',
        'marketing_orchestrator_readonly': 'lhm-marketing-hub:start',
        'google_drive_client_file_create': 'lhm-connector-repair',
        'basicops_task_discussion_update': 'lhm-connector-repair',
        'handback_target_registration': 'lhm-connector-repair',
    }[profile])
    if request.get('agent_id') != required_agent:
        reject(path, 'disallowed or missing plugin agent')
        return
    if (not isinstance(request.get('workflow_id'), str)
            or not re.fullmatch(r'[a-z0-9][a-z0-9-]{2,79}', request['workflow_id'])
            or not isinstance(request.get('required_skills'), list)
            or not request['required_skills']
            or not all(isinstance(item, str) and ':' in item for item in request['required_skills'])
            or not isinstance(request.get('required_capabilities'), list)
            or not all(isinstance(item, str) and re.fullmatch(r'[a-z0-9_.-]+', item) for item in request['required_capabilities'])):
        reject(path, 'missing or invalid workflow/skill/capability contract')
        return
    if governed and (request['controller_child_run_id'] != request['run_id']
                     or profile not in {'seo_gsc_readonly', 'specialist_readonly'}):
        reject(path, 'invalid governed controller child')
        return
    required_timeout = admitted_timeout_seconds(profile)
    if request.get('timeout_seconds') != required_timeout:
        reject(path, 'disallowed timeout_seconds')
        return
    run_id = request.get('run_id', '')
    prefix = {'google_ads_readonly': 'claude-gads', 'marketing_orchestrator_readonly': 'claude-mktg',
              'seo_gsc_readonly': 'claude-gsc',
              'google_drive_client_file_create': 'claude-gdrive',
              'basicops_task_discussion_update': 'claude-basicops',
              'handback_target_registration': 'claude-register',
              'specialist_readonly': 'claude-delegate',
              'html_artifact_producer': 'claude-producer'}[profile]
    if not re.fullmatch(prefix + r'-[0-9]{8}-[0-9]{2}', run_id):
        reject(path, 'invalid run_id')
        return
    if profile == 'handback_target_registration':
        complete_registration(path, request)
        return
    if profile == 'html_artifact_producer':
        if request.get('route') != 'content':
            reject(path, 'producer route must be content')
            return
        subject_name = request.get('subject_name')
        objective = request.get('objective')
        output_name = request.get('output_name')
        artifacts = request.get('input_artifacts')
        if not isinstance(subject_name, str) or not 2 <= len(subject_name) <= 120:
            reject(path, 'invalid subject_name')
            return
        if not isinstance(objective, str) or not 50 <= len(objective) <= 6000:
            reject(path, 'invalid objective length')
            return
        if not isinstance(output_name, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,119}\.html', output_name):
            reject(path, 'invalid output_name')
            return
        if not isinstance(artifacts, list) or len(artifacts) != 1 or not isinstance(artifacts[0], dict):
            reject(path, 'exactly one input artifact is required')
            return
        supplied = artifacts[0]
        if set(supplied) != {'artifact_id', 'logical_name', 'media_type', 'size_bytes', 'sha256', 'purpose'}:
            reject(path, 'invalid input artifact fields')
            return
        try:
            registry = json.loads(PRODUCER_REGISTRY.read_text(encoding='utf-8')).get('artifacts', {})
        except (OSError, json.JSONDecodeError, TypeError):
            reject(path, 'producer artifact registry unavailable')
            return
        registered = registry.get(supplied.get('artifact_id'))
        if not isinstance(registered, dict):
            reject(path, 'unknown input artifact')
            return
        for key in ('logical_name', 'media_type', 'size_bytes', 'sha256', 'purpose'):
            if supplied.get(key) != registered.get(key):
                reject(path, f'input artifact {key} mismatch')
                return
        source = Path(registered.get('source_path', '')).resolve()
        allowed_root = Path('/home/hermes/.hermes/profiles/lhm_brain/dispatch/claude/registered-artifacts').resolve()
        try:
            source.relative_to(allowed_root)
        except ValueError:
            reject(path, 'input artifact path outside protected prefix')
            return
        if not source.is_file() or source.is_symlink() or source.stat().st_size != supplied['size_bytes'] or source.stat().st_size > 200000:
            reject(path, 'input artifact unavailable, linked, wrong size, or too large')
            return
        if hashlib.sha256(source.read_bytes()).hexdigest() != supplied['sha256']:
            reject(path, 'input artifact digest mismatch')
            return
        if supplied['media_type'] != 'text/html' or supplied['purpose'] != 'source_copy':
            reject(path, 'disallowed input artifact type or purpose')
            return
        client = None
    elif profile == 'specialist_readonly':
        subject_type = request.get('subject_type')
        subject_name = request.get('subject_name')
        objective = request.get('objective')
        if request.get('route') not in SPECIALIST_ROUTES:
            reject(path, 'disallowed specialist route')
            return
        if subject_type not in {'client', 'opportunity', 'internal', 'general'}:
            reject(path, 'invalid subject_type')
            return
        if not isinstance(subject_name, str) or not 2 <= len(subject_name) <= 120 or any(ord(c) < 32 for c in subject_name):
            reject(path, 'invalid subject_name')
            return
        if request.get('approval_state') != 'review_only':
            reject(path, 'specialist route must be review_only')
            return
        if not isinstance(objective, str) or not 10 <= len(objective) <= 6000:
            reject(path, 'invalid objective length')
            return
        if any(ord(char) < 32 and char not in '\n\t' for char in objective):
            reject(path, 'invalid objective characters')
            return
        client = None
    elif profile == 'seo_gsc_readonly':
        site = GSC_SITES.get(request.get('site'))
        urls = request.get('urls')
        objective = request.get('objective')
        if site is None:
            reject(path, 'unregistered Search Console site')
            return
        if not isinstance(urls, list) or not 1 <= len(urls) <= 100 or len(set(urls)) != len(urls):
            reject(path, 'invalid URL list')
            return
        for url in urls:
            if not isinstance(url, str) or len(url) > 500:
                reject(path, 'invalid URL')
                return
            parsed = urlsplit(url)
            if parsed.scheme != 'https' or parsed.hostname != site['host'] or parsed.username or parsed.password or parsed.port or parsed.query or parsed.fragment:
                reject(path, 'URL is outside registered Search Console site or contains disallowed components')
                return
        if not isinstance(objective, str) or not 10 <= len(objective) <= 6000:
            reject(path, 'invalid objective length')
            return
        if any(ord(char) < 32 and char not in '\n\t' for char in objective):
            reject(path, 'invalid objective characters')
            return
        client = None
    else:
        canonical_clients = load_clients()
        if profile in handback_profiles and request.get('client') in canonical_clients:
            client = canonical_client_handback_target(canonical_clients[request['client']])
        else:
            clients = load_handback_targets() if profile in handback_profiles else canonical_clients
            if request.get('client') not in clients:
                reject(path, 'unregistered client')
                return
            client = clients[request['client']]
    if profile not in handback_profiles and profile not in {'specialist_readonly', 'seo_gsc_readonly', 'html_artifact_producer'}:
        objective = request.get('objective')
        if not isinstance(objective, str) or not 10 <= len(objective) <= 4000:
            reject(path, 'invalid objective length')
            return
        if any(ord(char) < 32 and char not in '\n\t' for char in objective):
            reject(path, 'invalid objective characters')
            return
    run_dir = RUNS / run_id
    if run_dir.exists():
        reject(path, 'run_id already exists')
        return
    run_dir.mkdir(mode=0o2750)
    if governed:
        os.chown(run_dir, 0, HERMES_GID)
        os.chmod(run_dir, 0o750)
    else:
        configure_worker_run_dir(run_dir)
    if profile == 'html_artifact_producer':
        prompt = {
            'profile': profile,
            'agent_id': request['agent_id'],
            'claude_agent': 'content',
            'subject_name': subject_name,
            'objective': objective,
            'output_name': output_name,
            'source_sha256': supplied['sha256'],
            'source_html': source.read_text(encoding='utf-8'),
        }
    elif profile == 'specialist_readonly':
        prompt = {
            'profile': profile,
            'agent_id': request['agent_id'],
            'claude_agent': SPECIALIST_ROUTES[request['route']][1],
            'route': request['route'],
            'subject_type': subject_type,
            'subject_name': subject_name,
            'objective': objective,
            'approval_state': 'review_only',
            'workflow_id': request['workflow_id'],
            'required_skills': request['required_skills'],
            'required_capabilities': request['required_capabilities'],
        }
    elif profile == 'seo_gsc_readonly':
        prompt = {
            'profile': profile,
            'agent_id': request['agent_id'],
            'site': request['site'],
            'site_name': site['name'],
            'site_property': site['property'],
            'urls': urls,
            'objective': objective,
            'required_skills': request['required_skills'],
            'required_capabilities': request['required_capabilities'],
            'approval_state': 'review_only',
        }
    else:
        prompt = {
            'profile': request['profile'],
            'agent_id': request['agent_id'],
            'client': request['client'],
            'client_name': client['name'],
            'workflow_id': request['workflow_id'],
            'required_skills': request['required_skills'],
            'required_capabilities': request['required_capabilities'],
        }
    if profile in {'specialist_readonly', 'seo_gsc_readonly', 'html_artifact_producer'}:
        pass
    elif profile not in handback_profiles:
        prompt.update(customer_id=client['customer_id'], manager_id=client['manager_id'], objective=objective)
        if profile == 'google_ads_readonly':
            prompt['evidence_pack'] = load_google_ads_evidence(client)
    elif profile == 'google_drive_client_file_create':
        artifact_path = request.get('artifact_path')
        file_name = request.get('file_name')
        allowed_prefix = client.get('vault_prefix', '')
        if not isinstance(artifact_path, str) or not artifact_path.startswith(allowed_prefix) or '..' in Path(artifact_path).parts:
            reject(path, 'artifact path is outside registered client scope')
            return
        source = (VAULT / artifact_path).resolve()
        try:
            source.relative_to(VAULT.resolve())
        except ValueError:
            reject(path, 'artifact path escapes vault')
            return
        if not source.is_file() or source.is_symlink() or source.stat().st_size > 200000:
            reject(path, 'artifact unavailable, linked, or too large')
            return
        if not isinstance(file_name, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9 ._()&-]{0,119}', file_name):
            reject(path, 'invalid file name')
            return
        prompt.update(artifact_path=artifact_path, file_name=file_name,
                      artifact_content=source.read_text(encoding='utf-8'),
                      drive_folder_query=client['drive_folder_query'])
    else:
        task_id = str(request.get('task_id', ''))
        discussion = request.get('discussion')
        if task_id not in {str(value) for value in client.get('basicops_task_ids', [])}:
            reject(path, 'task is outside registered client scope')
            return
        if not isinstance(discussion, str) or not 20 <= len(discussion) <= 20000:
            reject(path, 'invalid discussion length')
            return
        prompt.update(task_id=task_id, discussion=discussion)
    for name, payload in (('request.json', request), ('prompt.json', prompt)):
        item = run_dir / name
        item.write_text(json.dumps(payload, indent=2) + '\n', encoding='utf-8')
        os.chown(item, 0 if governed else WORKER_UID, HERMES_GID)
        os.chmod(item, 0o600 if governed else 0o640)
    events = run_dir / 'events.jsonl'
    summary = {
        'google_ads_readonly': 'Validated Google Ads read-only request queued for Claude.',
        'seo_gsc_readonly': 'Validated Search Console read-only request queued for Claude.',
        'marketing_orchestrator_readonly': 'Validated general marketing request queued for the Claude start orchestrator.',
        'google_drive_client_file_create': 'Validated scoped Google Drive file repair queued for Claude.',
        'basicops_task_discussion_update': 'Validated scoped BasicOps discussion repair queued for Claude.',
        'specialist_readonly': 'Validated delegate-first specialist request queued for Claude.',
        'html_artifact_producer': 'Validated bounded HTML producer request queued for Claude.',
    }[profile]
    events.write_text(json.dumps({'event': 'queued', 'run_id': run_id, 'summary': summary}) + '\n', encoding='utf-8')
    os.chown(events, 0 if governed else WORKER_UID, HERMES_GID)
    os.chmod(events, 0o600 if governed else 0o640)
    unit = f'lhm-claude-run-{run_id}'
    launch = ([
        'systemd-run', '--quiet', '--no-block', f'--unit={unit}',
        '--property=Type=oneshot', '--property=KillMode=process',
        '/usr/local/libexec/lhm-claude-dispatcher', '--supervise', str(run_dir), str(request['timeout_seconds'])
    ] if not governed else [
        'systemd-run', '--quiet', '--no-block', f'--unit={unit}',
        '--property=Type=oneshot', '--property=KillMode=process',
        '/opt/lhm-workflow/current/venv/bin/python',
        '/opt/lhm-workflow/current/integration/lhm_claude_trusted_supervisor.py',
        request['controller_child_run_id'], str(run_dir / 'prompt.json'), str(run_dir),
    ])
    subprocess.run(launch, check=True)
    shutil.move(str(path), PROCESSED / path.name)


def main():
    if len(sys.argv) == 4 and sys.argv[1] == '--supervise':
        timeout_seconds = int(sys.argv[3])
        if timeout_seconds not in {300, 600, 1200}:
            raise SystemExit('invalid supervisor timeout')
        raise SystemExit(supervise_worker(Path(sys.argv[2]), timeout_seconds))
    if len(sys.argv) != 1:
        raise SystemExit('unexpected arguments')
    for path in sorted(INCOMING.glob('*.json')):
        process(path)


if __name__ == '__main__':
    main()
