def admitted_timeout_seconds(profile):
    """Return the one bounded elapsed-time ceiling admitted for each profile."""
    if profile == 'handback_target_registration':
        return 30
    if profile == 'google_ads_readonly':
        return 600
    if profile == 'html_artifact_producer':
        return 1200
    return 600
