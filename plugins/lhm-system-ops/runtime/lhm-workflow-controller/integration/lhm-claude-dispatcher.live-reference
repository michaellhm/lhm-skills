def complete_registration(path, request):
    run_id = request['run_id']
    run_dir = RUNS / run_id
    if run_dir.exists():
        reject(path, 'run_id already exists')
        return
    run_dir.mkdir(mode=0o2750)
    os.chown(run_dir, 0, HERMES_GID)
    request_file = run_dir / 'request.json'
    request_file.write_text(json.dumps(request, indent=2) + '\n', encoding='utf-8')
    os.chown(request_file, 0, HERMES_GID)
    os.chmod(request_file, 0o640)

    def finish(status, action, error=None, target=None):
        final = {
            'run_id': run_id,
            'status': status,
            'profile': 'handback_target_registration',
            'agent_id': request['agent_id'],
            'completed_at': datetime.now(timezone.utc).isoformat(),
            'verification': {'verification': 'passed' if status == 'completed' else 'failed', 'action': action},
        }
        if target is not None:
            final['verification']['target'] = target
        if error:
            final['verification']['error'] = error
        final_file = run_dir / 'final.json'
        final_file.write_text(json.dumps(final, indent=2) + '\n', encoding='utf-8')
        os.chown(final_file, 0, HERMES_GID)
        os.chmod(final_file, 0o640)
        shutil.move(str(path), PROCESSED / path.name)

    target_type = request.get('target_type')
    slug = request.get('client')
    name = request.get('name')
    vault_prefix = request.get('vault_prefix')
    folder_id = request.get('drive_folder_id')
    task_ids = request.get('basicops_task_ids')
    if target_type not in {'client', 'opportunity'}:
        finish('failed', 'refused', 'target_type must be client or opportunity')
        return
    if not isinstance(slug, str) or not re.fullmatch(r'[a-z0-9]+(?:-[a-z0-9]+)*', slug):
        finish('failed', 'refused', 'invalid target slug')
        return
    if not isinstance(name, str) or not 2 <= len(name) <= 120 or any(ord(c) < 32 for c in name):
        finish('failed', 'refused', 'invalid target name')
        return
    allowed_root = '20 Clients/' if target_type == 'client' else '01 Inbox/Sales Opportunities/'
    if (not isinstance(vault_prefix, str) or not vault_prefix.startswith(allowed_root)
            or not vault_prefix.endswith('/') or '..' in Path(vault_prefix).parts):
        finish('failed', 'refused', f'vault prefix must be beneath {allowed_root}')
        return
    vault_dir = (VAULT / vault_prefix).resolve()
    try:
        vault_dir.relative_to(VAULT.resolve())
    except ValueError:
        finish('failed', 'refused', 'vault prefix escapes vault')
        return
    if not vault_dir.is_dir() or vault_dir.is_symlink():
        finish('failed', 'refused', 'vault folder does not exist or is linked')
        return
    if not isinstance(folder_id, str) or not re.fullmatch(r'[A-Za-z0-9_-]{10,100}', folder_id):
        finish('failed', 'refused', 'invalid Drive folder ID')
        return
    if (not isinstance(task_ids, list) or len(task_ids) > 20
            or any(not isinstance(value, str) or not re.fullmatch(r'[0-9]{1,20}', value) for value in task_ids)
            or len(set(task_ids)) != len(task_ids)):
        finish('failed', 'refused', 'invalid BasicOps task IDs')
        return
    try:
        payload = json.loads(HANDBACK_REGISTRY.read_text(encoding='utf-8'))
        targets = payload['clients']
    except (OSError, json.JSONDecodeError, KeyError, TypeError) as exc:
        finish('failed', 'refused', f'handback registry unavailable: {exc}')
        return
    target = {
        'type': target_type,
        'name': name,
        'vault_prefix': vault_prefix,
        'drive_folder_query': f'exact folder with folder ID {folder_id}',
        'basicops_task_ids': task_ids,
    }
    existing = targets.get(slug)
    legacy_target = {key: value for key, value in target.items() if key != 'type'}
    if existing == target or existing == legacy_target:
        finish('completed', 'already_existed', target=target)
        return
    if existing is not None:
        finish('failed', 'refused', 'slug is already registered with different details')
        return
    for other_slug, other in targets.items():
        if other.get('vault_prefix') == vault_prefix:
            finish('failed', 'refused', f'vault prefix already belongs to {other_slug}')
            return
        if folder_id in other.get('drive_folder_query', ''):
            finish('failed', 'refused', f'Drive folder already belongs to {other_slug}')
            return
    backup = HANDBACK_REGISTRY.with_name(
        f'.client-handback-targets.json.backup-{datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")}'
    )
    try:
        shutil.copy2(HANDBACK_REGISTRY, backup)
        os.chown(backup, 0, HERMES_GID)
        os.chmod(backup, 0o600)
    except OSError as exc:
        finish('failed', 'refused', f'registry backup failed: {exc}')
        return
    targets[slug] = target
    fd, temp_name = tempfile.mkstemp(prefix='.client-handback-targets.', dir=HANDBACK_REGISTRY.parent)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            json.dump(payload, handle, indent=2)
            handle.write('\n')
        os.chown(temp_name, 0, HERMES_GID)
        os.chmod(temp_name, 0o640)
        os.replace(temp_name, HANDBACK_REGISTRY)
    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)
    finish('completed', 'registered', target=target)


def load_clients():
    try:
        payload = json.loads(CLIENT_REGISTRY.read_text(encoding='utf-8'))
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(f'client registry unavailable: {exc}')
    clients = payload.get('clients')
    if not isinstance(clients, dict) or not clients:
        raise SystemExit('invalid client registry')
    required = {'name', 'customer_id', 'manager_id', 'evidence_prefix', 'evidence_files'}
    for slug, client in clients.items():
        if not re.fullmatch(r'[a-z0-9]+(?:-[a-z0-9]+)*', slug) or not required.issubset(client):
            raise SystemExit('invalid client registry entry')
        if not all(isinstance(client[key], str) and re.fullmatch(r'[0-9]{10}', client[key]) for key in ('customer_id', 'manager_id')):
            raise SystemExit('invalid client account id')
        evidence_files = client['evidence_files']
        if (not isinstance(evidence_files, list) or not 1 <= len(evidence_files) <= 8
                or len(set(evidence_files)) != len(evidence_files)):
            raise SystemExit('invalid client evidence file list')
        expected_prefix = client['evidence_prefix']
        if (not isinstance(expected_prefix, str) or not expected_prefix.startswith('20 Clients/')
                or not expected_prefix.endswith('/') or '..' in Path(expected_prefix).parts):
            raise SystemExit('invalid client evidence prefix')
        for relative in evidence_files:
            if (not isinstance(relative, str) or not relative.startswith(expected_prefix)
                    or not relative.endswith('.md') or '..' in Path(relative).parts):
                raise SystemExit('client evidence file is outside registered scope')
    return clients


def load_google_ads_evidence(client):
    """Read only the registered canonical files and return bounded, hashed evidence."""
    evidence = []
    total_bytes = 0
    vault_root = VAULT.resolve()
    for relative in client['evidence_files']:
        source = (VAULT / relative).resolve()
        try:
            source.relative_to(vault_root)
        except ValueError:
            raise SystemExit('registered evidence file escapes vault')
        if not source.is_file() or source.is_symlink():
            raise SystemExit(f'registered evidence file unavailable: {relative}')
        payload = source.read_bytes()
        if len(payload) > 40000:
            raise SystemExit(f'registered evidence file exceeds per-file limit: {relative}')
        total_bytes += len(payload)
        if total_bytes > 120000:
            raise SystemExit('registered evidence pack exceeds total limit')
        evidence.append({
            'path': relative,
            'sha256': hashlib.sha256(payload).hexdigest(),
            'content': payload.decode('utf-8'),
        })
    return evidence


