#!/usr/bin/env python3
"""Container-side queue writer for registered scheduled work."""
import argparse
import json
import os
import re
import tempfile
from datetime import datetime, timezone
from pathlib import Path

BASE = Path("/opt/data/profiles/lhm_brain/dispatch/scheduled-work")
SAFE = re.compile(r"^[a-z0-9][a-z0-9-]{0,79}$")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("workflow_key")
    parser.add_argument("source_cron_id")
    parser.add_argument("job_name")
    parser.add_argument("prompt")
    parser.add_argument("--occurrence")
    args = parser.parse_args()
    if not SAFE.fullmatch(args.workflow_key):
        raise SystemExit("invalid workflow key")
    now = datetime.now(timezone.utc)
    occurrence = args.occurrence or now.strftime("%Y%m%dT%H%MZ")
    if not re.fullmatch(r"[0-9]{8}T[0-9]{4}Z", occurrence):
        raise SystemExit("invalid occurrence")
    parent_run_id = f"{args.workflow_key}-{occurrence.lower()}"
    request = {
        "schema_version": 1,
        "workflow_key": args.workflow_key,
        "parent_run_id": parent_run_id,
        "event": {
            "source": "hermes-cron-alternate",
            "source_cron_id": args.source_cron_id,
            "job_name": args.job_name,
            "prompt": args.prompt,
            "delivery": "none",
            "triggered_at": now.isoformat(),
        },
    }
    incoming = BASE / "incoming"
    incoming.mkdir(parents=True, exist_ok=True)
    target = incoming / f"{parent_run_id}.json"
    fd, temporary = tempfile.mkstemp(prefix=f".{target.name}.", dir=incoming)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(request, handle, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, target)
    finally:
        Path(temporary).unlink(missing_ok=True)
    print(json.dumps({"parent_run_id": parent_run_id, "status": "queued_for_host_validation"}, sort_keys=True))


if __name__ == "__main__":
    main()
