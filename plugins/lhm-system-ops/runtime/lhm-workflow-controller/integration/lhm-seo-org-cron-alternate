#!/usr/bin/env python3
"""Disabled alternate entrypoint for Hermes cron 3994012c42ba."""
import argparse
import json
import os
import tempfile
from pathlib import Path

from lhm_workflow.org_routing import intake
from lhm_workflow.secureio import read_trusted

DEFAULT_OUTBOX = Path("/var/lib/lhm-workflow/org-intake")


def main():
    parser=argparse.ArgumentParser(); parser.add_argument("event",type=Path); parser.add_argument("parent_run_id")
    parser.add_argument("--outbox",type=Path,default=DEFAULT_OUTBOX); args=parser.parse_args()
    if args.outbox != DEFAULT_OUTBOX and os.environ.get("LHM_WORKFLOW_TEST_MODE") != "1":
        raise SystemExit("outbox override requires test mode")
    raw=(args.event.read_bytes() if os.environ.get("LHM_WORKFLOW_TEST_MODE") == "1"
         else read_trusted(args.event,root=args.event.parent,uid=0))
    event=json.loads(raw); value=intake(event,args.parent_run_id)
    args.outbox.mkdir(parents=True,exist_ok=True)
    target=args.outbox/f"{args.parent_run_id}.json"
    if target.exists():
        if json.loads(target.read_text()) != value: raise SystemExit("conflicting intake")
        return
    fd,tmp=tempfile.mkstemp(prefix=f".{args.parent_run_id}.",dir=args.outbox)
    try:
        with os.fdopen(fd,"w") as handle: json.dump(value,handle,sort_keys=True,separators=(",",":")); handle.write("\n"); handle.flush(); os.fsync(handle.fileno())
        os.chmod(tmp,0o600); os.replace(tmp,target)
    finally: Path(tmp).unlink(missing_ok=True)


if __name__=="__main__": main()
