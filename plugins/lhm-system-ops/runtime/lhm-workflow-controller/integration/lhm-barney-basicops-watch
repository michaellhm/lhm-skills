#!/usr/bin/env python3
"""Bounded BasicOps watchlist monitor for tasks outside controller state."""
from __future__ import annotations

import json
import os
import tempfile
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(os.environ.get("LHM_BARNEY_BASICOPS_WATCH_ROOT", "/var/lib/lhm-workflow/barney-basicops-watch"))
WATCHES = ROOT / "watches"
STATE = ROOT / "state"
ENDPOINT = os.environ.get("LHM_BASICOPS_MCP_ENDPOINT", "https://app.basicops.com/mcp?agent=barney-ai")
TERMINAL = {"Under Review", "Reviewed", "Blocked", "Cancelled", "On Hold", "Complete"}
BARNEY_USER_ID = 82519
DEFAULT_STALE_MINUTES = 180


def _iso_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def _atomic(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(value, handle, sort_keys=True)
            handle.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def _rpc(token: str, method: str, params: dict | None = None) -> dict:
    body = {"jsonrpc": "2.0", "id": 1, "method": method}
    if params is not None:
        body["params"] = params
    request = urllib.request.Request(
        ENDPOINT,
        data=json.dumps(body, separators=(",", ":")).encode(),
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=40) as response:
        result = json.load(response)
    if result.get("error"):
        raise RuntimeError(result["error"].get("message") or "BasicOps RPC error")
    return result.get("result") or {}


def _tool(token: str, name: str, arguments: dict) -> dict:
    result = _rpc(token, "tools/call", {"name": name, "arguments": arguments})
    for item in result.get("content", []):
        if item.get("type") == "text":
            return json.loads(item.get("text") or "{}")
    raise RuntimeError(f"BasicOps {name} returned no JSON text")


def _mention(user_id: int, name: str) -> str:
    return f'<span class="user-link record-link" _tableid="3922" _id="{user_id}">{name}</span>'


def _message(watch: dict, task: dict) -> str:
    assignee = task.get("assignee") or {}
    assignee_id = int(assignee.get("id") or watch["assignee_user_id"])
    assignee_name = assignee.get("firstName") or watch["assignee_name"]
    return (
        f"<p><b>Barney supervisory check, {_mention(assignee_id, assignee_name)}.</b> "
        f"This task is still <b>{task.get('status')}</b> and has had no non-Barney activity for three hours.</p>"
        f"<p><b>Expected next event:</b> {watch['expected_next_event']}</p>"
        "<p>Please post the evidence-backed progress state, or the exact blocker, owner and next check time. "
        "I will not repeat this report unless somebody else updates the task and it later becomes stale again.</p>"
        "<p>A true story is always legendary. A recurring reminder is just a calendar notification in a suit. 🥃</p>"
    )


def _latest_external_message(token: str, task_id: int, barney_user_id: int) -> dict | None:
    result = _tool(token, "list_messages_in_task", {"taskId": task_id})
    messages = result.get("data") or []
    external = [item for item in messages if int(item.get("user") or 0) != barney_user_id]
    return max(external, key=lambda item: int(item.get("created") or 0), default=None)


def main() -> None:
    credential_dir = Path(os.environ["CREDENTIALS_DIRECTORY"])
    token = (credential_dir / "basicops-api-key").read_text().strip()
    now = datetime.now(timezone.utc)
    summary = []
    for watch_path in sorted(WATCHES.glob("*.json")):
        watch = json.loads(watch_path.read_text())
        task_id = int(watch["task_id"])
        state_path = STATE / f"{task_id}.json"
        state = json.loads(state_path.read_text()) if state_path.exists() else {
            "task_id": task_id,
            "next_check_at": watch["next_check_at"],
            "last_message_id": None,
            "last_external_message_id": None,
            "reported_for_message_id": None,
            "status": "watching",
        }
        task = _tool(token, "get_task", {"taskId": task_id})
        if task.get("status") in TERMINAL:
            state.update(status="paused", pause_reason=f"task status is {task.get('status')}", observed_at=_iso_now())
            _atomic(state_path, state)
            summary.append({"task_id": task_id, "result": "paused", "status": task.get("status")})
            continue
        stale_minutes = int(watch.get("stale_after_minutes") or DEFAULT_STALE_MINUTES)
        external = _latest_external_message(token, task_id, int(watch.get("barney_user_id") or BARNEY_USER_ID))
        external_id = str(external.get("id")) if external else "task-created"
        external_created = int(external.get("created") or task.get("created") or 0) if external else int(task.get("created") or 0)
        stale_at = datetime.fromtimestamp(external_created / 1000, timezone.utc) + timedelta(minutes=stale_minutes)
        if state.get("last_external_message_id") != external_id:
            state.update(
                last_external_message_id=external_id,
                next_check_at=stale_at.isoformat(),
                reported_for_message_id=None,
                status="watching",
                observed_at=_iso_now(),
            )
            _atomic(state_path, state)
            summary.append({"task_id": task_id, "result": "external-activity-observed", "next_check_at": state["next_check_at"]})
            continue
        if state.get("reported_for_message_id") == external_id:
            summary.append({"task_id": task_id, "result": "stale-already-reported", "external_message_id": external_id})
            continue
        next_check = datetime.fromisoformat(state["next_check_at"].replace("Z", "+00:00"))
        if now < next_check:
            summary.append({"task_id": task_id, "result": "not-due", "next_check_at": state["next_check_at"]})
            continue
        created = _tool(token, "create_message_in_task", {"taskId": task_id, "message": _message(watch, task)})
        state.update(
            last_message_id=str(created.get("id")),
            reported_for_message_id=external_id,
            next_check_at=(now + timedelta(minutes=stale_minutes)).isoformat(),
            status="reported",
            observed_at=_iso_now(),
        )
        _atomic(state_path, state)
        summary.append({"task_id": task_id, "result": "reminded", "message_id": state["last_message_id"], "next_check_at": state["next_check_at"]})
    print(json.dumps({"checked_at": _iso_now(), "watches": summary}, sort_keys=True))


if __name__ == "__main__":
    main()
