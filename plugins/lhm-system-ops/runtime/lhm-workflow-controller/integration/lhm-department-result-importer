#!/usr/bin/env python3
import sys
from pathlib import Path
from lhm_workflow.result_importer import process,quarantine
ROOT=Path("/var/lib/lhm-workflow");role=sys.argv[1]
for path in sorted((ROOT/f"{role}-results").glob("*.json")):
 try:process(path,ROOT,role)
 except Exception as exc:quarantine(path,ROOT,str(exc))
