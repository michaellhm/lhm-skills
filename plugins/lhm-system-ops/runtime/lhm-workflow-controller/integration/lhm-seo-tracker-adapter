#!/usr/bin/env python3
"""Root-only candidate adapter for tracker CAS write and exact readback."""
import argparse,json,os,sys
from pathlib import Path
from lhm_workflow.tracker_connector import TrackerConnector,summary_from_parent
from lhm_workflow.secureio import read_trusted

VAULT=Path("/home/hermes/.hermes/profiles/lhm_brain/vault")
ROUTER=Path("/var/lib/lhm-workflow/org-router")
def main():
    if os.geteuid()!=0 and os.environ.get("LHM_WORKFLOW_TEST_MODE")!="1": raise SystemExit("root adapter only")
    p=argparse.ArgumentParser(); p.add_argument("action",choices=("write","readback")); p.add_argument("expected_sha256")
    p.add_argument("--vault",type=Path,default=VAULT); a=p.parse_args()
    if a.vault!=VAULT and os.environ.get("LHM_WORKFLOW_TEST_MODE")!="1": raise SystemExit("vault override requires test mode")
    test=os.environ.get("LHM_WORKFLOW_TEST_MODE")=="1"; canary=os.environ.get("LHM_WORKFLOW_CANARY_MODE")=="1" and (os.geteuid() in {0,10110} or test)
    if canary:
        canary_root=Path(os.environ["LHM_WORKFLOW_CANARY_ROOT"]); a.vault=canary_root/"vault"; router_root=canary_root/"router"
    else: router_root=ROUTER
    connector=TrackerConnector(a.vault)
    if a.action=="write":
        request=json.load(sys.stdin); parent_id=request.get("parent_run_id",""); parent_path=router_root/"parents"/f"{parent_id}.json"
        parent=json.loads(read_trusted(parent_path,root=router_root/"parents",uid=os.getuid() if test else 0))
        artifact,_=connector.append_structured(summary_from_parent(parent,request),a.expected_sha256)
    else: artifact,_=connector.readback(a.expected_sha256)
    print(json.dumps({"observer":"host-knowledge-adapter","action":a.action,"artifact":artifact,"readback":True},sort_keys=True))
if __name__=="__main__": main()
