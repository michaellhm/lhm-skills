[Unit]
Description=Import closed authenticated BasicOps human decision observations

[Service]
Type=oneshot
Environment=PYTHONPATH=/opt/lhm-workflow/current/src
User=root
ExecStart=/usr/local/libexec/lhm-delegated-basicops-bridge import-human
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lhm-workflow
