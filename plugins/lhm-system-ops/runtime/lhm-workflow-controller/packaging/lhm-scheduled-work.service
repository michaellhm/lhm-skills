[Unit]
Description=Validate and admit registered Hermes scheduled work
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/lhm-scheduled-work-runtime
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermes/.hermes/profiles/lhm_brain/dispatch/scheduled-work /home/hermes/.hermes/profiles/lhm_chief_of_staff/dispatch/scheduled-executor /home/hermes/.hermes/profiles/lhm_production/dispatch/scheduled-executor /home/hermes/.hermes/profiles/lhm_researcher/dispatch/scheduled-executor /home/hermes/.hermes/profiles/lhm_seo/dispatch/scheduled-executor /home/hermes/.hermes/profiles/lhm_content/dispatch/scheduled-executor /home/hermes/.hermes/profiles/lhm_website/dispatch/scheduled-executor /home/hermes/.hermes/profiles/lhm_verifier/dispatch/scheduled-executor /home/hermes/.hermes/profiles/lhm_operations_connector/dispatch/scheduled-executor /home/hermes/.hermes/profiles/lhm_learning_steward/dispatch/scheduled-executor /var/lib/lhm-workflow
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
UMask=0027
