[Unit]
Description=Validate and admit registered Hermes scheduled work
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/lhm-scheduled-work-runtime
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermes/.hermes/profiles/lhm_brain/dispatch/scheduled-work /home/hermes/.hermes/profiles/lhm_brain/dispatch/scheduled-executor /var/lib/lhm-workflow
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
UMask=0027
