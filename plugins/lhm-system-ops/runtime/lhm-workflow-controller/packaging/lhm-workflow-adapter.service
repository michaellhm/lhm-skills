[Unit]
Description=Seal host-derived LHM worker evidence

[Service]
Type=oneshot
User=lhmworkflowadapter
Group=lhmworkflow
SupplementaryGroups=lhmworkflowadapter lhmadapterkey
UMask=0027
WorkingDirectory=/opt/lhm-workflow/current
Environment=PYTHONPATH=/opt/lhm-workflow/current/src PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/lhm-workflow/current/venv/bin/python -m lhm_workflow.daemon adapter-scan
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
ReadOnlyPaths=/var/lib/lhm-workflow/worker /var/lib/lhm-workflow/secrets/adapter.key
ReadWritePaths=/var/lib/lhm-workflow/adapter-source /var/lib/lhm-workflow/adapter-incoming /var/lib/lhm-workflow/processed/adapter-source /var/lib/lhm-workflow/quarantine/adapter
