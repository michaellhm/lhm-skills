[Unit]
Description=LHM departmental QA receipt producer
[Service]
Type=oneshot
User=lhmdepartmentqa
Group=lhmdepartmentqa
ExecStart=/opt/lhm-workflow/current/venv/bin/python -m lhm_workflow.department_receipt_producer /var/lib/lhm-workflow/qa-requests/request.json /var/lib/lhm-workflow/qa-requests/evidence.json /var/lib/lhm-workflow/qa-results/result.json --request-root /var/lib/lhm-workflow/qa-requests --key /var/lib/lhm-workflow/secrets/department-qa.private.pem --claude-public /var/lib/lhm-workflow/public/verifier.public.pem
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/lhm-workflow/departmental-parents /var/lib/lhm-workflow/secrets/department-qa.private.pem /var/lib/lhm-workflow/public/verifier.public.pem /var/lib/lhm-workflow/public/evidence-attestor.public.pem
ReadWritePaths=/var/lib/lhm-workflow/qa-requests /var/lib/lhm-workflow/qa-results
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
