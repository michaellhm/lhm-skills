{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "workflow_version", "run_id", "worker_route", "client_id", "meeting_locator", "evidence_mode", "evidence_package", "founder_context", "requested_outputs", "permissions", "approval_stage", "success_test", "timeout_seconds"],
  "properties": {
    "workflow_id": {"const": "client_meeting_capture"},
    "workflow_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$"},
    "worker_route": {"const": "codex"},
    "client_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "meeting_locator": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "call_url": {"type": "string", "pattern": "^https://fathom\\.video/calls/[0-9]+$"},
        "call_id": {"type": "string", "pattern": "^[0-9]+$"},
        "date": {"type": "string", "format": "date"},
        "title_hint": {"type": "string", "minLength": 1, "maxLength": 200}
      },
      "anyOf": [{"required": ["call_url"]}, {"required": ["call_id"]}, {"required": ["date", "title_hint"]}]
    },
    "evidence_mode": {"enum": ["worker_fathom", "compatibility_relay"]},
    "evidence_package": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["meeting", "summary", "transcript", "retrieved_at", "summary_sha256", "transcript_sha256"],
      "properties": {
        "meeting": {"type": "object"},
        "summary": {"type": "string", "maxLength": 500000},
        "transcript": {"type": "string", "maxLength": 2000000},
        "retrieved_at": {"type": "string"},
        "summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "transcript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "founder_context": {
      "type": "object", "additionalProperties": false,
      "required": ["transcript", "inclusions", "exclusions", "internal_only"],
      "properties": {
        "transcript": {"type": "string", "maxLength": 10000},
        "inclusions": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 500}},
        "exclusions": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 500}},
        "internal_only": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 500}}
      }
    },
    "requested_outputs": {
      "type": "object", "additionalProperties": false,
      "required": ["client_email", "meeting_record", "proposed_client_updates", "delegation_pack"],
      "properties": {
        "client_email": {"const": true}, "meeting_record": {"const": true},
        "proposed_client_updates": {"type": "boolean"}, "delegation_pack": {"type": "boolean"}
      }
    },
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["read_fathom", "read_client_context", "stage_artifacts", "apply_vault", "create_gmail_draft", "basicops"],
      "properties": {
        "read_fathom": {"const": true}, "read_client_context": {"const": true}, "stage_artifacts": {"const": true},
        "apply_vault": {"const": false}, "create_gmail_draft": {"const": false}, "basicops": {"const": false}
      }
    },
    "approval_stage": {"const": "review_only"},
    "success_test": {"type": "array", "minItems": 1, "maxItems": 15, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 1800}
  }
}
