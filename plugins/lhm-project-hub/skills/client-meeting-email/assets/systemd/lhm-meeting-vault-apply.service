[Unit]
Description=Apply explicitly approved meeting vault changes

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/lhm-meeting-vault-apply
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermes/.hermes/profiles/lhm_brain/dispatch /home/hermes/.hermes/profiles/lhm_brain/vault
