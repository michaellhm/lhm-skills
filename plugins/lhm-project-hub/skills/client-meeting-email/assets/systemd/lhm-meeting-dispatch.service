[Unit]
Description=Validate and dispatch registered client meeting captures

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/lhm-meeting-dispatcher
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermes/.hermes/profiles/lhm_brain/dispatch /home/codexworker/.codex
RuntimeDirectory=lhm-meeting-run lhm-meeting-snapshot
RuntimeDirectoryMode=0755
